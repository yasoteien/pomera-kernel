			tc35894-irq {
				rockchip,pins = <0x00 0x07 0x00 0x59>;
				phandle = <0x50>;
			};

			tc35894-reset {
				rockchip,pins = <0x00 0x19 0x00 0x59>;
				phandle = <0x51>;
			};
		};

		display {

			backlight-enable {
				rockchip,pins = <0x00 0x1b 0x00 0x5b>;
				phandle = <0x5e>;
			};

			panel-enable {
				rockchip,pins = <0x00 0x18 0x00 0x59>;
				phandle = <0x61>;
			};
		};

		bluetooth {

			bt-reset {
				rockchip,pins = <0x03 0x15 0x00 0x59>;
				phandle = <0x48>;
			};

			bt-wake {
				rockchip,pins = <0x03 0x1a 0x00 0x59>;
				phandle = <0x49>;
			};

			bt-host-wake {
				rockchip,pins = <0x03 0x16 0x00 0x59>;
				phandle = <0x4a>;
			};
		};

		wireless {

			wifi-power {
				rockchip,pins = <0x00 0x1e 0x00 0x59>;
				phandle = <0x5c>;
			};

			wifi-host-wake {
				rockchip,pins = <0x03 0x17 0x00 0x59>;
				phandle = <0x29>;
			};

			wifi-reset {
				rockchip,pins = <0x03 0x1b 0x00 0x59>;
				phandle = <0x5d>;
			};
		};
	};

	chosen {
		stdout-path = "/serial@20064000";
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x40000000>;
	};

	wifi-vcc {
		compatible = "regulator-fixed";
		gpio = <0x4f 0x1e 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x5c>;
		regulator-name = "wifi-vcc";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		startup-delay-us = <0x186a0>;
		phandle = <0x24>;
	};

	wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0x5d>;
		reset-gpios = <0x28 0x1b 0x01>;
		post-power-on-delay-ms = <0xc8>;
		phandle = <0x23>;
	};

	backlight {
		compatible = "pwm-backlight";
		brightness-levels = <0xff 0x00>;
		num-interpolated-steps = <0xff>;
		default-brightness-level = <0x80>;
		enable-gpios = <0x4f 0x1b 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x5e>;
		pwms = <0x5f 0x00 0x61a8 0x00>;
		phandle = <0x60>;
	};

	battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <0x588040>;
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x401640>;
		constant-charge-current-max-microamp = <0x2ab980>;
		constant-charge-voltage-max-microvolt = <0x401640>;
		factory-internal-resistance-micro-ohms = <0xafc8>;
		ocv-capacity-celsius = <0x14>;
		ocv-capacity-table-0 = <0x401640 0x64 0x3f2028 0x5f 0x3e9b58 0x5a 0x3e12a0 0x55 0x3d8dd0 0x50 0x3cda20 0x4b 0x3c12e8 0x46 0x3bb910 0x41 0x3b5f38 0x3c 0x3b0948 0x37 0x3ab740 0x32 0x3a6920 0x2d 0x3a1b00 0x28 0x39cce0 0x23 0x397308 0x1e 0x391d18 0x19 0x38b3a0 0x14 0x383a88 0x0f 0x37fc08 0x0a 0x3782f0 0x05 0x33e140 0x00>;
		phandle = <0x53>;
	};

	panel {
		compatible = "panel-lvds";
		backlight = <0x60>;
		data-mapping = "jeida-18";
		enable-gpios = <0x4f 0x18 0x00>;
		height-mm = <0x7d>;
		pinctrl-names = "default";
		pinctrl-0 = <0x61>;
		power-supply = <0x62>;
		width-mm = <0xdf>;

		panel-timing {
			clock-frequency = <0x30d4000>;
			hactive = <0x400>;
			vactive = <0x258>;
			hback-porch = <0x64>;
			hfront-porch = <0xd2>;
			hsync-len = <0x0a>;
			vback-porch = <0x08>;
			vfront-porch = <0x19>;
			vsync-len = <0x02>;
			hsync-active = <0x00>;
			vsync-active = <0x00>;
			de-active = <0x00>;
			pixelclk-active = <0x00>;
		};

		port {

			endpoint {
				remote-endpoint = <0x63>;
				phandle = <0x39>;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0x64>;

		power-key {
			label = "Power Button";
			linux,code = <0x74>;
			gpios = <0x4f 0x02 0x01>;
			debounce-interval = <0x64>;
			wakeup-source;
		};

		lid-switch {
			label = "Lid Switch";
			linux,code = <0x00>;
			linux,input-type = <0x05>;
			gpios = <0x4f 0x14 0x01>;
			debounce-interval = <0x64>;
			wakeup-source;
		};

		right-shift {
			label = "Right Shift";
			linux,code = <0x36>;
			gpios = <0x4f 0x0c 0x01>;
			debounce-interval = <0x32>;
			wakeup-source;
		};

		left-alt {
			label = "Left Alt";
			linux,code = <0x38>;
			gpios = <0x4f 0x0d 0x01>;
			debounce-interval = <0x32>;
			wakeup-source;
		};
	};
};
