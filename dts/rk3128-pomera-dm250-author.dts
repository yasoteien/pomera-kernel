		pcfg-output-low {
			bias-disable;
			output-low;
			phandle = <0x5b>;
		};

		pcfg-pull-up {
			bias-pull-up;
		};

		buttons {

			dm250-button-pins {
				rockchip,pins = <0x00 0x02 0x00 0x59 0x00 0x14 0x00 0x59 0x00 0x0c 0x00 0x59 0x00 0x0d 0x00 0x59>;
