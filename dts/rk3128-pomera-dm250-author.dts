// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * KING JIM Pomera DM250 (RK3128) — 作者の Debian 11 イメージの RSCE に入っている DTB
 *
 * (C) Copyright 2017 Rockchip Electronics Co., Ltd（rk3128.dtsi に由来する部分）
 * Copyright (C) 2026 yasoteien（この頭書きと、DTB を DTS に戻した形）
 *
 * 出どころ:
 *   - DM250 用 Debian 11 イメージ（https://www.ekesete.net/log/?p=9565）の
 *     RSCE 領域（項目 rk-kernel.dtb）にある DTB。sha256
 *     bd97037c2e7eddb99a9a4042e1ffc716402c5199450aafbe3a5bacf6ef8b4c48（32301 バイト）。
 *   - その DTB は https://github.com/jcs/linux-dm250 の pomera-dm250.dts
 *     （(GPL-2.0+ OR MIT)）と本家の rk3128.dtsi（GPL-2.0+）から組まれた物。
 *     このためライセンスは両方を満たす GPL-2.0-or-later とする。
 *   - dtc 1.7.2 で DTB から戻した（dtc -I dtb -O dts）。phandle は数値のまま。
 *
 * 組み方（元の DTB と 1 バイトも違わない物が出る）:
 *   dtc -q -b 0 -I dts -O dtb -o rk3128-pomera-dm250-author.dtb rk3128-pomera-dm250-author.dts
 *
 * このファイルは作者の DTB そのままで、直しは入れていない。今使っている DTB は
 * mk_rsce.sh が、これに mk_leds.sh（RK818 の INT の結線、充電 LED）と
 * mk_panel.sh（パネルの寸法）の直しを当てて作る。
 */

/dts-v1/;

/ {
	compatible = "kingjim,pomera-dm250", "rockchip,rk3128";
	interrupt-parent = <0x01>;
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "King Jim Pomera DM250";

	aliases {
		gpio0 = "/pinctrl/gpio@2007c000";
		gpio1 = "/pinctrl/gpio@20080000";
		gpio2 = "/pinctrl/gpio@20084000";
		gpio3 = "/pinctrl/gpio@20088000";
		i2c0 = "/i2c@20072000";
		i2c1 = "/i2c@20056000";
		i2c2 = "/i2c@2005a000";
		i2c3 = "/i2c@2005e000";
		serial0 = "/serial@20060000";
		serial1 = "/serial@20064000";
		serial2 = "/serial@20068000";
		mmc0 = "/mmc@1021c000";
		mmc1 = "/mmc@10214000";
	};

	arm-pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x00 0x4c 0x04 0x00 0x4d 0x04 0x00 0x4e 0x04 0x00 0x4f 0x04>;
		interrupt-affinity = <0x02 0x03 0x04 0x05>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		enable-method = "rockchip,rk3036-smp";

		cpu@f00 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			capacity-dmips-mhz = <0x400>;
			reg = <0xf00>;
			clocks = <0x06 0x05>;
			resets = <0x06 0x04>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x08>;
			phandle = <0x02>;
		};

		cpu@f01 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			capacity-dmips-mhz = <0x400>;
			reg = <0xf01>;
			resets = <0x06 0x05>;
			operating-points-v2 = <0x07>;
			cpu-supply = <0x08>;
			phandle = <0x03>;
		};

		cpu@f02 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			capacity-dmips-mhz = <0x400>;
			reg = <0xf02>;
			resets = <0x06 0x06>;
			operating-points-v2 = <0x07>;
			cpu-supply = <0x08>;
			phandle = <0x04>;
		};

		cpu@f03 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			capacity-dmips-mhz = <0x400>;
			reg = <0xf03>;
			resets = <0x06 0x07>;
			operating-points-v2 = <0x07>;
			cpu-supply = <0x08>;
			phandle = <0x05>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x07>;

		opp-216000000 {
			opp-hz = <0x00 0xcdfe600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x1437c8>;
			clock-latency-ns = <0x9c40>;
		};

		opp-408000000 {
			opp-hz = <0x00 0x18519600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x1437c8>;
			clock-latency-ns = <0x9c40>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x1437c8>;
			clock-latency-ns = <0x9c40>;
		};

		opp-696000000 {
			opp-hz = <0x00 0x297c1e00>;
			opp-microvolt = <0xee098 0xee098 0x1437c8>;
			clock-latency-ns = <0x9c40>;
		};

		opp-816000000 {
			opp-hz = <0x00 0x30a32c00>;
			opp-microvolt = <0x106738 0x106738 0x1437c8>;
			opp-suspend;
			clock-latency-ns = <0x9c40>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0x124f80 0x124f80 0x1437c8>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0x1437c8 0x1437c8 0x1437c8>;
			clock-latency-ns = <0x9c40>;
		};
	};

	display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <0x09>;
		status = "okay";
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		phandle = <0x0a>;

		opp-200000000 {
			opp-hz = <0x00 0xbebc200>;
			opp-microvolt = <0xee098 0xee098 0x1312d0>;
		};

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			opp-microvolt = <0x100590 0x100590 0x1312d0>;
		};

		opp-400000000 {
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0x118c30 0x118c30 0x1312d0>;
		};

		opp-480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt = <0x1312d0 0x1312d0 0x1312d0>;
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04 0x01 0x0b 0xf04 0x01 0x0a 0xf04>;
		arm,cpu-registers-not-fw-configured;
		clock-frequency = <0x16e3600>;
	};

	oscillator {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		#clock-cells = <0x00>;
		phandle = <0x36>;
	};

	sram@10080000 {
		compatible = "mmio-sram";
		reg = <0x10080000 0x2000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x10080000 0x2000>;

		smp-sram@0 {
			compatible = "rockchip,rk3066-smp-sram";
			reg = <0x00 0x10>;
		};
	};

	gpu@10090000 {
		compatible = "rockchip,rk3128-mali", "arm,mali-400";
		reg = <0x10090000 0x10000>;
		interrupts = <0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04 0x00 0x04 0x04 0x00 0x05 0x04 0x00 0x04 0x04>;
		interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0", "pp1", "ppmmu1";
		clocks = <0x06 0xd5 0x06 0xd5>;
		clock-names = "bus", "core";
		operating-points-v2 = <0x0a>;
		resets = <0x06 0x78>;
		power-domains = <0x0b 0x03>;
		status = "okay";
		mali-supply = <0x0c>;
	};

	syscon@100a0000 {
		compatible = "rockchip,rk3128-pmu", "syscon", "simple-mfd";
		reg = <0x100a0000 0x1000>;

		power-controller {
			compatible = "rockchip,rk3128-power-controller";
			#power-domain-cells = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x0b>;

			power-domain@1 {
				reg = <0x01>;
				clocks = <0x06 0xc6 0x06 0x1d6 0x06 0xbf 0x06 0x1d1 0x06 0xc7 0x06 0x1d4 0x06 0xcc 0x06 0x1cf 0x06 0x145 0x06 0x172 0x06 0x94 0x06 0xcd 0x06 0x1d3 0x06 0xc0 0x06 0xc1 0x06 0x1d2 0x06 0x1d5 0x06 0xbe 0x06 0x7a>;
				pm_qos = <0x0d 0x0e 0x0f 0x10 0x11>;
				#power-domain-cells = <0x00>;
			};

			power-domain@2 {
				reg = <0x02>;
				clocks = <0x06 0xc5 0x06 0x1ce 0x06 0xc4 0x06 0x1cd 0x06 0x86>;
				pm_qos = <0x12>;
				#power-domain-cells = <0x00>;
			};

			power-domain@3 {
				reg = <0x03>;
				clocks = <0x06 0xd5>;
				pm_qos = <0x13>;
				#power-domain-cells = <0x00>;
			};
		};
	};

	video-codec@10106000 {
		compatible = "rockchip,rk3128-vpu", "rockchip,rk3066-vpu";
		reg = <0x10106000 0x800>;
		interrupts = <0x00 0x06 0x04 0x00 0x07 0x04>;
		interrupt-names = "vepu", "vdpu";
		clocks = <0x06 0xc5 0x06 0x1ce 0x06 0xc4 0x06 0x1cd>;
		clock-names = "aclk_vdpu", "hclk_vdpu", "aclk_vepu", "hclk_vepu";
		iommus = <0x14>;
		power-domains = <0x0b 0x02>;
	};

	iommu@10106800 {
		compatible = "rockchip,iommu";
		reg = <0x10106800 0x100>;
		interrupts = <0x00 0x43 0x04>;
		clocks = <0x06 0xc4 0x06 0x1ce>;
		clock-names = "aclk", "iface";
		power-domains = <0x0b 0x02>;
		#iommu-cells = <0x00>;
		phandle = <0x14>;
	};

	vop@1010e000 {
		compatible = "rockchip,rk3126-vop";
		reg = <0x1010e000 0x300>;
		interrupts = <0x00 0x09 0x04>;
		clocks = <0x06 0xcc 0x06 0xbe 0x06 0x1cf>;
		clock-names = "aclk_vop", "dclk_vop", "hclk_vop";
		resets = <0x06 0x64 0x06 0x65 0x06 0x66>;
		reset-names = "axi", "ahb", "dclk";
		power-domains = <0x0b 0x01>;
		status = "okay";

		port {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x09>;

			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <0x15>;
				phandle = <0x3d>;
			};

			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <0x16>;
				phandle = <0x1a>;
			};

			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <0x17>;
				phandle = <0x38>;
			};
		};
	};

	dsi@10110000 {
		compatible = "rockchip,rk3128-mipi-dsi", "snps,dw-mipi-dsi";
		reg = <0x10110000 0x4000>;
		interrupts = <0x00 0x21 0x04>;
		clocks = <0x06 0x145>;
		clock-names = "pclk";
		phys = <0x18>;
		phy-names = "dphy";
		power-domains = <0x0b 0x01>;
		resets = <0x06 0x89>;
		reset-names = "apb";
		rockchip,grf = <0x19>;
		status = "disabled";

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				endpoint {
					remote-endpoint = <0x1a>;
					phandle = <0x16>;
				};
			};

			port@1 {
				reg = <0x01>;
			};
		};
	};

	qos@1012d000 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012d000 0x20>;
		phandle = <0x13>;
	};

	qos@1012e000 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012e000 0x20>;
		phandle = <0x12>;
	};

	qos@1012f000 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012f000 0x20>;
		phandle = <0x10>;
	};

	qos@1012f080 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012f080 0x20>;
		phandle = <0x0d>;
	};

	qos@1012f100 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012f100 0x20>;
		phandle = <0x0e>;
	};

	qos@1012f180 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012f180 0x20>;
		phandle = <0x0f>;
	};

	qos@1012f200 {
		compatible = "rockchip,rk3128-qos", "syscon";
		reg = <0x1012f200 0x20>;
		phandle = <0x11>;
	};

	interrupt-controller@10139000 {
		compatible = "arm,cortex-a7-gic";
		reg = <0x10139000 0x1000 0x1013a000 0x1000 0x1013c000 0x2000 0x1013e000 0x2000>;
		interrupts = <0x01 0x09 0xf04>;
		interrupt-controller;
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		phandle = <0x01>;
	};

	usb@10180000 {
		compatible = "rockchip,rk3128-usb", "rockchip,rk3066-usb", "snps,dwc2";
		reg = <0x10180000 0x40000>;
		interrupts = <0x00 0x0a 0x04>;
		clocks = <0x06 0x1da>;
		clock-names = "otg";
		dr_mode = "host";
		g-np-tx-fifo-size = <0x10>;
		g-rx-fifo-size = <0x118>;
		g-tx-fifo-size = <0x100 0x80 0x80 0x40 0x20 0x10>;
		phys = <0x1b>;
		phy-names = "usb2-phy";
		status = "okay";
	};

	usb@101c0000 {
		compatible = "generic-ehci";
		reg = <0x101c0000 0x20000>;
		interrupts = <0x00 0x0b 0x04>;
		clocks = <0x06 0x1d9>;
		phys = <0x1c>;
		phy-names = "usb";
		status = "disabled";
	};

	usb@101e0000 {
		compatible = "generic-ohci";
		reg = <0x101e0000 0x20000>;
		interrupts = <0x00 0x20 0x04>;
		clocks = <0x06 0x1d9>;
		phys = <0x1c>;
		phy-names = "usb";
		status = "disabled";
	};

	i2s@10200000 {
		compatible = "rockchip,rk3128-i2s", "rockchip,rk3066-i2s";
		reg = <0x10200000 0x1000>;
		interrupts = <0x00 0x44 0x04>;
		clocks = <0x06 0x50 0x06 0x1bb>;
		clock-names = "i2s_clk", "i2s_hclk";
		dmas = <0x1d 0x0e 0x1d 0x0f>;
		dma-names = "tx", "rx";
		#sound-dai-cells = <0x00>;
		status = "disabled";
	};

	spdif@10204000 {
		compatible = "rockchip,rk3128-spdif", "rockchip,rk3066-spdif";
		reg = <0x10204000 0x1000>;
		interrupts = <0x00 0x37 0x04>;
		clocks = <0x06 0x53 0x06 0x1b8>;
		clock-names = "mclk", "hclk";
		dmas = <0x1d 0x0d>;
		dma-names = "tx";
		pinctrl-names = "default";
		pinctrl-0 = <0x1e>;
		#sound-dai-cells = <0x00>;
		status = "disabled";
	};

	spi@1020c000 {
		compatible = "rockchip,sfc";
		reg = <0x1020c000 0x8000>;
		interrupts = <0x00 0x32 0x04>;
		clocks = <0x06 0x99 0x06 0x1df>;
		clock-names = "clk_sfc", "hclk_sfc";
		status = "disabled";
	};

	mmc@10214000 {
		compatible = "rockchip,rk3128-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x10214000 0x4000>;
		interrupts = <0x00 0x0e 0x04>;
		clocks = <0x06 0x1c8 0x06 0x44 0x06 0x72 0x06 0x76>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		dmas = <0x1d 0x0a>;
		dma-names = "rx-tx";
		fifo-depth = <0x100>;
		max-frequency = <0x23c3460>;
		resets = <0x06 0x51>;
		reset-names = "reset";
		status = "okay";
		broken-cd;
		bus-width = <0x04>;
		cap-sd-highspeed;
		pinctrl-names = "default";
		pinctrl-0 = <0x1f 0x20 0x21>;
		vmmc-supply = <0x22>;
	};

	mmc@10218000 {
		compatible = "rockchip,rk3128-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x10218000 0x4000>;
		interrupts = <0x00 0x0f 0x04>;
		clocks = <0x06 0x1c9 0x06 0x45 0x06 0x73 0x06 0x77>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		dmas = <0x1d 0x0b>;
		dma-names = "rx-tx";
		fifo-depth = <0x100>;
		max-frequency = <0x2faf080>;
		resets = <0x06 0x52>;
		reset-names = "reset";
		status = "okay";
		bus-width = <0x04>;
		cap-sd-highspeed;
		cap-sdio-irq;
		keep-power-in-suspend;
		mmc-pwrseq = <0x23>;
		vmmc-supply = <0x24>;
		non-removable;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x25 0x26 0x27>;

		wifi@1 {
			compatible = "brcm,bcm4329-fmac";
			reg = <0x01>;
			interrupt-parent = <0x28>;
			interrupts = <0x17 0x08>;
			interrupt-names = "host-wake";
			pinctrl-names = "default";
			pinctrl-0 = <0x29>;
			brcm,ccode-map-trivial;
		};
	};

	mmc@1021c000 {
		compatible = "rockchip,rk3128-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x1021c000 0x4000>;
		interrupts = <0x00 0x10 0x04>;
		clocks = <0x06 0x1cb 0x06 0x47 0x06 0x75 0x06 0x79>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		dmas = <0x1d 0x0c>;
		dma-names = "rx-tx";
		fifo-depth = <0x100>;
		max-frequency = <0x2faf080>;
		resets = <0x06 0x53>;
		reset-names = "reset";
		status = "okay";
		bus-width = <0x08>;
		cap-mmc-highspeed;
		mmc-ddr-3_3v;
		no-sd;
		no-sdio;
		non-removable;
		pinctrl-names = "default";
		pinctrl-0 = <0x2a 0x2b 0x2c>;
	};

	i2s@10220000 {
		compatible = "rockchip,rk3128-i2s", "rockchip,rk3066-i2s";
		reg = <0x10220000 0x1000>;
		interrupts = <0x00 0x13 0x04>;
		clocks = <0x06 0x51 0x06 0x1bc>;
		clock-names = "i2s_clk", "i2s_hclk";
		dmas = <0x1d 0x00 0x1d 0x01>;
		dma-names = "tx", "rx";
		rockchip,playback-channels = <0x02>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2d>;
		#sound-dai-cells = <0x00>;
		status = "disabled";
	};

	nand-controller@10500000 {
		compatible = "rockchip,rk3128-nfc", "rockchip,rk2928-nfc";
		reg = <0x10500000 0x4000>;
		interrupts = <0x00 0x12 0x04>;
		clocks = <0x06 0x1c5 0x06 0x43>;
		clock-names = "ahb", "nfc";
		pinctrl-names = "default";
		pinctrl-0 = <0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35>;
		status = "disabled";
	};

	clock-controller@20000000 {
		compatible = "rockchip,rk3128-cru";
		reg = <0x20000000 0x1000>;
		clocks = <0x36>;
		clock-names = "xin24m";
		rockchip,grf = <0x19>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		assigned-clocks = <0x06 0x04>;
		assigned-clock-rates = <0x2367b880>;
		phandle = <0x06>;
	};

	syscon@20008000 {
		compatible = "rockchip,rk3128-grf", "syscon", "simple-mfd";
		reg = <0x20008000 0x1000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x19>;

		usb2phy@17c {
			compatible = "rockchip,rk3128-usb2phy";
