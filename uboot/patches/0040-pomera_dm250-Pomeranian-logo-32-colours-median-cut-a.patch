diff --git a/board/kingjim/pomera_dm250/mklogo.py b/board/kingjim/pomera_dm250/mklogo.py
index ff591ed9cd..a993888ef6 100755
--- a/board/kingjim/pomera_dm250/mklogo.py
+++ b/board/kingjim/pomera_dm250/mklogo.py
@@ -2,6 +2,12 @@
 # Make the U-Boot logo for the Pomera DM250 (8-bit RLE8 BMP), without PIL.
 #
 #   mklogo.py png IN.png OUT.bmp       PNG (8-bit RGB/RGBA/grey/palette) -> RLE8 BMP
+#   mklogo.py png IN.png OUT.bmp N [BLACK]
+#                                      same, but reduce to N colours picked from the
+#                                      picture (median cut, no dithering). Pixels whose
+#                                      channels are all <= BLACK (default 24) become
+#                                      pure black first, so JPEG noise in a black
+#                                      background does not turn into extra colours
 #   mklogo.py chart OUT.bmp            the provisional picture: a 1024x600 test chart
 #   mklogo.py preview IN.bmp OUT.png [X Y]
 #                                      draw IN.bmp on a 1024x600 RGB565 screen the way
@@ -107,8 +113,61 @@ def quantize(px):
     return pal, [[(near(p[0], 6) * 7 + near(p[1], 7)) * 6 + near(p[2], 6) for p in row] for row in px]
 
 
-def write_bmp_rle8(path, w, h, px):
-    pal, rows = quantize(px)
+def median_cut(px, n, black=24):
+    """Return (palette, index rows) with at most n colours, no dithering.
+
+    Boxes are split and colours matched in (brightness, 1.5*(R-G), 1.5*(B-G)),
+    so a small pale tint (pink cheeks on white fur) gets its own colour
+    instead of being eaten by the many grey shades.
+    """
+    px = [[(0, 0, 0) if max(p) <= black else p for p in row] for row in px]
+    cols = {}
+    for row in px:
+        for p in row:
+            cols[p] = cols.get(p, 0) + 1
+
+    def tf(c):
+        r, g, b = c
+        return ((r + g + b) / 3, 1.5 * (r - g), 1.5 * (b - g))
+
+    T = {c: tf(c) for c in cols}
+
+    def rng(bx, k):
+        v = [T[c][k] for c in bx]
+        return max(v) - min(v)
+
+    boxes = [[c for c in cols if c != (0, 0, 0)]]
+    want = n - 1 if (0, 0, 0) in cols else n
+    while len(boxes) < want:
+        bx = max((b for b in boxes if len(b) > 1),
+                 key=lambda b: max(rng(b, k) for k in range(3)), default=None)
+        if bx is None:
+            break
+        k = max(range(3), key=lambda k: rng(bx, k))
+        bx.sort(key=lambda c: T[c][k])
+        tot, half, cut = sum(cols[c] for c in bx), 0, 1
+        for i, c in enumerate(bx):
+            half += cols[c]
+            if half * 2 >= tot:
+                cut = min(max(i, 1), len(bx) - 1)
+                break
+        boxes.remove(bx)
+        boxes += [bx[:cut], bx[cut:]]
+    pal = []
+    for bx in boxes:
+        if bx:
+            t = sum(cols[c] for c in bx)
+            pal.append(tuple(round(sum(c[k] * cols[c] for c in bx) / t) for k in range(3)))
+    if (0, 0, 0) in cols:
+        pal.insert(0, (0, 0, 0))
+    PT = [tf(c) for c in pal]
+    near = {c: min(range(len(pal)), key=lambda i: sum((T[c][k] - PT[i][k]) ** 2 for k in range(3)))
+            for c in cols}
+    return pal, [[near[p] for p in row] for row in px]
+
+
+def write_bmp_rle8(path, w, h, px, ncol=0, black=24):
+    pal, rows = median_cut(px, ncol, black) if ncol else quantize(px)
     data = bytearray()
     for y in range(h - 1, -1, -1):          # BMP rows go bottom-up
         row, x = rows[y], 0
@@ -248,11 +307,15 @@ def chart(out):
 
 if __name__ == "__main__":
     cmd = sys.argv[1] if len(sys.argv) > 1 else ""
-    if cmd == "png" and len(sys.argv) == 4:
+    if cmd == "png" and len(sys.argv) in (4, 5, 6):
         w, h, px = read_png(sys.argv[2])
         if w > SCREEN_W or h > SCREEN_H:
             sys.exit(f"{w}x{h} is larger than the {SCREEN_W}x{SCREEN_H} screen")
-        n, size = write_bmp_rle8(sys.argv[3], w, h, px)
+        ncol = int(sys.argv[4]) if len(sys.argv) > 4 else 0
+        if ncol and not 2 <= ncol <= 256:
+            sys.exit("N must be 2..256")
+        black = int(sys.argv[5]) if len(sys.argv) > 5 else 24
+        n, size = write_bmp_rle8(sys.argv[3], w, h, px, ncol, black)
         print(f"{w}x{h}, {n} colours, {size} bytes")
     elif cmd == "chart" and len(sys.argv) == 3:
         chart(sys.argv[2])
