From 76843235e1b2f47d459c326b1b353d151797e1a5 Mon Sep 17 00:00:00 2001
From: joshua stein <jcs@jcs.org>
Date: Sat, 7 Mar 2026 17:23:08 -0600
Subject: [PATCH 26/46] pomera-dm250: Enable tc3589x keyboard as stdin device

Use SILENT_CONSOLE properly so boot can be interrupted without
needing to reconfigure stdout
---
 configs/pomera-dm250_defconfig | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/configs/pomera-dm250_defconfig b/configs/pomera-dm250_defconfig
index 8f74c9574f..517e6e7f0f 100644
--- a/configs/pomera-dm250_defconfig
+++ b/configs/pomera-dm250_defconfig
@@ -12,10 +12,16 @@ CONFIG_DEBUG_UART_BASE=0x20064000
 CONFIG_DEBUG_UART_CLOCK=24000000
 CONFIG_DEBUG_UART=y
 CONFIG_BOOTDELAY=1
+CONFIG_OF_BOARD_SETUP=y
 CONFIG_FDT_SIMPLEFB=y
-CONFIG_DEFAULT_FDT_FILE="rockchip/pomera-dm250.dtb"
+CONFIG_BOOTCOMMAND="setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; cls; bootefi bootmgr"
 CONFIG_USE_PREBOOT=y
-CONFIG_PREBOOT="setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; fdt addr ${fdtcontroladdr}; fdt set /chosen stdout-path /framebuffer"
+CONFIG_PREBOOT="setenv silent 1; setenv stdin serial,tc3589x-keyb; setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; fdt addr ${fdtcontroladdr}; fdt set /chosen stdout-path /framebuffer; fatload mmc 0 ${loadaddr} logo.bmp; bmp d ${loadaddr} m m"
+CONFIG_DEFAULT_FDT_FILE="rockchip/pomera-dm250.dtb"
+CONFIG_SILENT_CONSOLE=y
+# CONFIG_SPL_SILENT_CONSOLE is not set
+# CONFIG_TPL_SILENT_CONSOLE is not set
+CONFIG_SILENT_U_BOOT_ONLY=y
 # CONFIG_DISPLAY_CPUINFO is not set
 CONFIG_DISPLAY_BOARDINFO_LATE=y
 CONFIG_CMD_GPT=y
@@ -28,14 +34,14 @@ CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_BMP=y
 CONFIG_CMD_TIME=y
 CONFIG_OF_EMBED=y
-CONFIG_OF_BOARD_SETUP=y
 CONFIG_ENV_IS_IN_MMC=y
-CONFIG_SYS_RELOC_GD_ENV_ADDR=y
 CONFIG_FASTBOOT_BUF_ADDR=0x60800800
 CONFIG_FASTBOOT_BUF_SIZE=0x04000000
 CONFIG_FASTBOOT_CMD_OEM_FORMAT=y
 CONFIG_ROCKCHIP_GPIO=y
 CONFIG_SYS_I2C_ROCKCHIP=y
+CONFIG_DM_KEYBOARD=y
+CONFIG_TC3589X_KEYB=y
 # CONFIG_ROCKCHIP_EFUSE is not set
 CONFIG_MMC_DW=y
 CONFIG_MMC_DW_ROCKCHIP=y
-- 
2.47.3

