From aeafa294477ef4effae8771d470ada73138e1e2d Mon Sep 17 00:00:00 2001
From: joshua stein <jcs@jcs.org>
Date: Tue, 3 Mar 2026 12:35:11 -0600
Subject: [PATCH 23/46] pomera-dm250: Switch /chosen/stdout-path to framebuffer

---
 configs/pomera-dm250_defconfig | 30 ++++++++++++++++++++----------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/configs/pomera-dm250_defconfig b/configs/pomera-dm250_defconfig
index 08b0f4a70f..8f74c9574f 100644
--- a/configs/pomera-dm250_defconfig
+++ b/configs/pomera-dm250_defconfig
@@ -12,7 +12,10 @@ CONFIG_DEBUG_UART_BASE=0x20064000
 CONFIG_DEBUG_UART_CLOCK=24000000
 CONFIG_DEBUG_UART=y
 CONFIG_BOOTDELAY=1
+CONFIG_FDT_SIMPLEFB=y
 CONFIG_DEFAULT_FDT_FILE="rockchip/pomera-dm250.dtb"
+CONFIG_USE_PREBOOT=y
+CONFIG_PREBOOT="setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; fdt addr ${fdtcontroladdr}; fdt set /chosen stdout-path /framebuffer"
 # CONFIG_DISPLAY_CPUINFO is not set
 CONFIG_DISPLAY_BOARDINFO_LATE=y
 CONFIG_CMD_GPT=y
@@ -22,8 +25,10 @@ CONFIG_CMD_USB=y
 CONFIG_CMD_ROCKUSB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 # CONFIG_CMD_SETEXPR is not set
+CONFIG_CMD_BMP=y
 CONFIG_CMD_TIME=y
 CONFIG_OF_EMBED=y
+CONFIG_OF_BOARD_SETUP=y
 CONFIG_ENV_IS_IN_MMC=y
 CONFIG_SYS_RELOC_GD_ENV_ADDR=y
 CONFIG_FASTBOOT_BUF_ADDR=0x60800800
@@ -41,16 +46,6 @@ CONFIG_PMIC_RK8XX=y
 CONFIG_REGULATOR_PWM=y
 CONFIG_REGULATOR_RK8XX=y
 CONFIG_PWM_ROCKCHIP=y
-CONFIG_VIDEO=y
-CONFIG_DISPLAY=y
-CONFIG_VIDEO_ROCKCHIP=y
-CONFIG_VIDEO_ROCKCHIP_MAX_XRES=1024
-CONFIG_VIDEO_ROCKCHIP_MAX_YRES=600
-CONFIG_DISPLAY_ROCKCHIP_LVDS=y
-CONFIG_BACKLIGHT_PWM=y
-CONFIG_PANEL=y
-CONFIG_SIMPLE_PANEL=y
-# CONFIG_CONSOLE_MUX is not set
 # CONFIG_REQUIRE_SERIAL_CONSOLE is not set
 CONFIG_DEBUG_UART_SHIFT=2
 CONFIG_SYS_NS16550_MEM32=y
@@ -64,3 +59,18 @@ CONFIG_USB_DWC2=y
 CONFIG_USB_GADGET=y
 CONFIG_USB_GADGET_DWC2_OTG=y
 CONFIG_USB_FUNCTION_ROCKUSB=y
+CONFIG_VIDEO=y
+CONFIG_VIDEO_LOGO=y
+CONFIG_DISPLAY=y
+CONFIG_VIDEO_ROCKCHIP=y
+CONFIG_VIDEO_ROCKCHIP_MAX_XRES=1024
+CONFIG_VIDEO_ROCKCHIP_MAX_YRES=600
+CONFIG_DISPLAY_ROCKCHIP_LVDS=y
+CONFIG_VIDEO_DT_SIMPLEFB=y
+CONFIG_SPLASH_SCREEN=y
+CONFIG_SPLASH_SCREEN_ALIGN=y
+CONFIG_HIDE_LOGO_VERSION=y
+CONFIG_SPLASH_SOURCE=y
+CONFIG_BMP_16BPP=y
+CONFIG_BMP_24BPP=y
+CONFIG_BMP_32BPP=y
