From 4aa9fbee1dcb1fa8bd74d82c5a76d7a969086937 Mon Sep 17 00:00:00 2001
From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Date: Wed, 4 Nov 2026 15:27:34 +0900
Subject: [PATCH 41/46] pomera_dm250: build the DTB from a flat DTS; fix LVDS
 mapping and backlight polarity

The DTS is the author DTB decompiled, with two fixes from the datasheet
check: panel data-mapping jeida-24 -> jeida-18 (matches the kernel GRF
value 0x03cf034c) and backlight PWM polarity inverted -> normal (as in
the kernel DT). dts/Makefile compiles a flat .dts next to the .dtb with
plain dtc (no cpp, no -u-boot.dtsi); the output equals the reviewed
fixed.dtb byte for byte. rk3126_lvds.c: comments only (8BIT_2 is
JEIDA-24, 8BIT_3 is JEIDA-18).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
 drivers/video/rockchip/rk3126_lvds.c          |    4 +-
 dts/Makefile                                  |   11 +
 .../src/arm/rockchip/rk3128-pomera-dm250.dts  | 1565 +++++++++++++++++
 3 files changed, 1578 insertions(+), 2 deletions(-)
 create mode 100644 dts/upstream/src/arm/rockchip/rk3128-pomera-dm250.dts

diff --git a/drivers/video/rockchip/rk3126_lvds.c b/drivers/video/rockchip/rk3126_lvds.c
index e1346c3061..2b7b789b49 100644
--- a/drivers/video/rockchip/rk3126_lvds.c
+++ b/drivers/video/rockchip/rk3126_lvds.c
@@ -35,8 +35,8 @@ DECLARE_GLOBAL_DATA_PTR;
 
 /* LVDS output format values */
 #define LVDS_FMT_8BIT_1	0
-#define LVDS_FMT_8BIT_2	1
-#define LVDS_FMT_8BIT_3	2  /* JEIDA-24 */
+#define LVDS_FMT_8BIT_2	1  /* JEIDA-24 */
+#define LVDS_FMT_8BIT_3	2  /* JEIDA-18 */
 #define LVDS_FMT_6BIT	3
 
 struct rk3126_lvds_priv {
diff --git a/dts/Makefile b/dts/Makefile
index b15c74ea49..0bd4eb67af 100644
--- a/dts/Makefile
+++ b/dts/Makefile
@@ -50,7 +50,18 @@ endif
 
 targets += dt.dtb
 
+# A flat .dts next to the .dtb (decompiled and fixed, no #include) is
+# compiled as is: no cpp and no *-u-boot.dtsi, so the result is exactly the
+# source. Without one, the prebuilt .dtb is used.
+ifneq ($(wildcard $(srctree)/$(DTB:.dtb=.dts)),)
+quiet_cmd_dtc_flat = DTC     $@
+      cmd_dtc_flat = mkdir -p $(dir $@) && $(DTC) -q -I dts -O dtb -o $@ $<
+$(DTB): $(srctree)/$(DTB:.dtb=.dts) $(DTC) FORCE
+	$(call if_changed,dtc_flat)
+targets += $(DTB)
+else
 $(DTB):
+endif
 #$(DTB): arch-dtbs $(local_dtbos)
 #	$(Q)test -e $@ || (						\
 #	echo >&2;							\
