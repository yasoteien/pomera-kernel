diff --git a/board/kingjim/pomera_dm250/mklogo.py b/board/kingjim/pomera_dm250/mklogo.py
new file mode 100755
index 0000000000..ff591ed9cd
--- /dev/null
+++ b/board/kingjim/pomera_dm250/mklogo.py
@@ -0,0 +1,263 @@
+#!/usr/bin/env python3
+# Make the U-Boot logo for the Pomera DM250 (8-bit RLE8 BMP), without PIL.
+#
+#   mklogo.py png IN.png OUT.bmp       PNG (8-bit RGB/RGBA/grey/palette) -> RLE8 BMP
+#   mklogo.py chart OUT.bmp            the provisional picture: a 1024x600 test chart
+#   mklogo.py preview IN.bmp OUT.png [X Y]
+#                                      draw IN.bmp on a 1024x600 RGB565 screen the way
+#                                      U-Boot does (same placement rules), and save it
+#
+# The screen is 1024x600 RGB565. Colours are rounded to 565 when shown.
+import struct
+import sys
+import zlib
+
+SCREEN_W, SCREEN_H = 1024, 600
+
+
+# ---------------------------------------------------------------- PNG in/out
+def read_png(path):
+    d = open(path, "rb").read()
+    assert d[:8] == b"\x89PNG\r\n\x1a\n", "not a PNG"
+    pos, idat, plte, trns = 8, b"", None, None
+    while pos < len(d):
+        n, t = struct.unpack(">I4s", d[pos:pos + 8])
+        c = d[pos + 8:pos + 8 + n]
+        pos += 12 + n
+        if t == b"IHDR":
+            w, h, depth, ctype, _, _, inter = struct.unpack(">IIBBBBB", c)
+        elif t == b"PLTE":
+            plte = [tuple(c[i:i + 3]) for i in range(0, len(c), 3)]
+        elif t == b"tRNS":
+            trns = c
+        elif t == b"IDAT":
+            idat += c
+    if depth != 8 or inter != 0:
+        sys.exit("only 8-bit, non-interlaced PNG is supported")
+    ch = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[ctype]
+    raw = zlib.decompress(idat)
+    stride = w * ch
+    rows, prev, p = [], bytearray(stride), 0
+    for _ in range(h):
+        f = raw[p]
+        line = bytearray(raw[p + 1:p + 1 + stride])
+        p += 1 + stride
+        for i in range(stride):
+            a = line[i - ch] if i >= ch else 0
+            b = prev[i]
+            c = prev[i - ch] if i >= ch else 0
+            if f == 1:
+                line[i] = (line[i] + a) & 255
+            elif f == 2:
+                line[i] = (line[i] + b) & 255
+            elif f == 3:
+                line[i] = (line[i] + (a + b) // 2) & 255
+            elif f == 4:
+                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
+                pr = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
+                line[i] = (line[i] + pr) & 255
+        rows.append(bytes(line))
+        prev = line
+    px = []
+    for line in rows:
+        r = []
+        for x in range(w):
+            v = line[x * ch:(x + 1) * ch]
+            if ctype == 0:
+                rgb, al = (v[0],) * 3, 255
+            elif ctype == 4:
+                rgb, al = (v[0],) * 3, v[1]
+            elif ctype == 2:
+                rgb, al = tuple(v), 255
+            elif ctype == 6:
+                rgb, al = tuple(v[:3]), v[3]
+            else:
+                rgb = plte[v[0]]
+                al = trns[v[0]] if trns and v[0] < len(trns) else 255
+            # transparent parts go on the black background
+            r.append(tuple(c * al // 255 for c in rgb))
+        px.append(r)
+    return w, h, px
+
+
+def write_png(path, w, h, px):
+    raw = b"".join(b"\0" + bytes(c for p in row for c in p) for row in px)
+    def chunk(t, c):
+        return struct.pack(">I", len(c)) + t + c + struct.pack(">I", zlib.crc32(t + c))
+    open(path, "wb").write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
+                          + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
+
+
+# ---------------------------------------------------------------- BMP RLE8
+def quantize(px):
+    """Return (palette, index rows). Exact if <= 256 colours, else a 6x7x6 cube."""
+    cols = {}
+    for row in px:
+        for p in row:
+            cols[p] = cols.get(p, 0) + 1
+    if len(cols) <= 256:
+        pal = sorted(cols, key=lambda c: -cols[c])
+        idx = {c: i for i, c in enumerate(pal)}
+        return pal, [[idx[p] for p in row] for row in px]
+    lv = lambda n: [round(i * 255 / (n - 1)) for i in range(n)]
+    R, G, B = lv(6), lv(7), lv(6)
+    pal = [(r, g, b) for r in R for g in G for b in B]
+    def near(v, n):
+        return min(n - 1, max(0, round(v * (n - 1) / 255)))
+    return pal, [[(near(p[0], 6) * 7 + near(p[1], 7)) * 6 + near(p[2], 6) for p in row] for row in px]
+
+
+def write_bmp_rle8(path, w, h, px):
+    pal, rows = quantize(px)
+    data = bytearray()
+    for y in range(h - 1, -1, -1):          # BMP rows go bottom-up
+        row, x = rows[y], 0
+        while x < w:
+            v, n = row[x], 1
+            while x + n < w and n < 255 and row[x + n] == v:
+                n += 1
+            data += bytes((n, v))
+            x += n
+        data += b"\0\0"                     # end of line
+    data[-2:] = b"\0\1"                     # end of bitmap replaces the last EOL
+    palb = b"".join(bytes((b, g, r, 0)) for r, g, b in pal)
+    off = 14 + 40 + len(palb)
+    hdr = struct.pack("<2sIHHI", b"BM", off + len(data), 0, 0, off)
+    info = struct.pack("<IiiHHIIiiII", 40, w, h, 1, 8, 1, len(data), 2835, 2835, len(pal), 0)
+    open(path, "wb").write(hdr + info + palb + bytes(data))
+    return len(pal), off + len(data)
+
+
+def read_bmp(path):
+    d = open(path, "rb").read()
+    off, = struct.unpack_from("<I", d, 10)
+    hsz, w, h, _, bpp, comp, _, _, _, nclr, _ = struct.unpack_from("<IiiHHIIiiII", d, 14)
+    pal = [(d[14 + hsz + 4 * i + 2], d[14 + hsz + 4 * i + 1], d[14 + hsz + 4 * i]) for i in range(nclr or 256)]
+    return d, off, w, h, bpp, comp, pal
+
+
+# ---------------------------------------------------------------- preview
+def to565(c):
+    r, g, b = c[0] >> 3, c[1] >> 2, c[2] >> 3
+    return (r << 3 | r >> 2, g << 2 | g >> 4, b << 3 | b >> 2)
+
+
+def align(pos, panel, pic):
+    # video_splash_align_axis()
+    if pos == 0x7fff:
+        pos = (panel - pic) // 2
+    elif pos < 0:
+        pos = panel - pic + pos + 1
+    else:
+        return pos
+    return max(0, pos)
+
+
+def preview(bmp, out, x0=-4, y0=4):
+    d, off, w, h, bpp, comp, pal = read_bmp(bmp)
+    assert bpp == 8 and comp == 1, "preview handles RLE8 only"
+    x0, y0 = align(x0, SCREEN_W, w), align(y0, SCREEN_H, h)
+    W, H = min(w, SCREEN_W - x0), min(h, SCREEN_H - y0)
+    scr = [[(0, 0, 0)] * SCREEN_W for _ in range(SCREEN_H)]
+    p, x, y = off, 0, h - 1
+    while True:
+        a, b = d[p], d[p + 1]
+        if a == 0:
+            if b == 0:
+                x, y, p = 0, y - 1, p + 2
+                continue
+            if b == 1:
+                break
+            if b == 2:
+                sys.exit("DELTA is not produced by this tool")
+            vals, p = d[p + 2:p + 2 + b], p + 2 + b + (b & 1)
+        else:
+            vals, p = bytes((b,)) * a, p + 2
+        for v in vals:
+            if x < W and y < H:
+                scr[y0 + y][x0 + x] = to565(pal[v])
+            x += 1
+    write_png(out, SCREEN_W, SCREEN_H, scr)
+    print(f"logo {w}x{h} drawn at x={x0} y={y0}")
+
+
+# ---------------------------------------------------------------- test chart
+FONT = {  # 5x7
+    "P": ["1111", "1001", "1001", "1110", "1000", "1000", "1000"],
+    "O": ["0110", "1001", "1001", "1001", "1001", "1001", "0110"],
+    "M": ["10001", "11011", "10101", "10101", "10001", "10001", "10001"],
+    "E": ["1111", "1000", "1000", "1110", "1000", "1000", "1111"],
+    "R": ["1110", "1001", "1001", "1110", "1010", "1001", "1001"],
+    "A": ["0110", "1001", "1001", "1111", "1001", "1001", "1001"],
+    "T": ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
+    "S": ["0111", "1000", "1000", "0110", "0001", "0001", "1110"],
+    " ": ["00", "00", "00", "00", "00", "00", "00"],
+}
+
+
+def chart(out):
+    W, H = SCREEN_W, SCREEN_H
+    K, WH, RD, GR, BL, YE, CY, MA = (0, 0, 0), (255, 255, 255), (255, 0, 0), (0, 255, 0), (0, 0, 255), (255, 255, 0), (0, 255, 255), (255, 0, 255)
+    px = [[K] * W for _ in range(H)]
+
+    def rect(x, y, w, h, c):
+        for yy in range(max(0, y), min(H, y + h)):
+            for xx in range(max(0, x), min(W, x + w)):
+                px[yy][xx] = c
+
+    def frame(x, y, w, h, c):
+        rect(x, y, w, 1, c); rect(x, y + h - 1, w, 1, c)
+        rect(x, y, 1, h, c); rect(x + w - 1, y, 1, h, c)
+
+    frame(0, 0, W, H, WH)              # the outermost pixel ring
+    frame(8, 8, W - 16, H - 16, RD)    # 8 px inside
+    # ticks every 16 px; every 64 px longer and coloured
+    for x in range(0, W, 16):
+        L, c = (24, YE) if x % 64 == 0 else (10, WH)
+        rect(x, 0, 1, L, c); rect(x, H - L, 1, L, c)
+    for y in range(0, H, 16):
+        L, c = (24, YE) if y % 64 == 0 else (10, WH)
+        rect(0, y, L, 1, c); rect(W - L, y, L, 1, c)
+    # corners, each its own colour
+    for (x, y), c in (((1, 1), RD), ((W - 33, 1), GR), ((1, H - 33), BL), ((W - 33, H - 33), YE)):
+        rect(x, y, 32, 32, c)
+    # where the U-Boot logo sits today (160x160 at x=861, y=4)
+    frame(861, 4, 160, 160, CY)
+    frame(862, 5, 158, 158, CY)
+    # colour bars for 565 rounding
+    for i, c in enumerate((WH, RD, GR, BL, YE, CY, MA)):
+        rect(192 + i * 64, 440, 64, 48, c)
+    # a grey ramp in 16 steps
+    for i in range(16):
+        v = i * 17
+        rect(256 + i * 32, 500, 32, 32, (v, v, v))
+    # the text, 8x scaled
+    def text(s, x, y, sc, c):
+        for ch in s:
+            g = FONT[ch]
+            for j, line in enumerate(g):
+                for i, bit in enumerate(line):
+                    if bit == "1":
+                        rect(x + i * sc, y + j * sc, sc, sc, c)
+            x += (len(g[0]) + 1) * sc
+    text("POMERA", 512 - 6 * 6 * 10 // 2 + 10, 200, 10, WH)
+    text("TEST", 512 - 4 * 6 * 5 // 2 + 10, 300, 5, MA)
+    n, size = write_bmp_rle8(out, W, H, px)
+    print(f"chart {W}x{H}, {n} colours, {size} bytes")
+
+
+if __name__ == "__main__":
+    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
+    if cmd == "png" and len(sys.argv) == 4:
+        w, h, px = read_png(sys.argv[2])
+        if w > SCREEN_W or h > SCREEN_H:
+            sys.exit(f"{w}x{h} is larger than the {SCREEN_W}x{SCREEN_H} screen")
+        n, size = write_bmp_rle8(sys.argv[3], w, h, px)
+        print(f"{w}x{h}, {n} colours, {size} bytes")
+    elif cmd == "chart" and len(sys.argv) == 3:
+        chart(sys.argv[2])
+    elif cmd == "preview" and len(sys.argv) in (4, 6):
+        x, y = (int(sys.argv[4], 0), int(sys.argv[5], 0)) if len(sys.argv) == 6 else (-4, 4)
+        preview(sys.argv[2], sys.argv[3], x, y)
+    else:
+        sys.exit(__doc__ if __doc__ else open(__file__).read().split("import")[0])
diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index c2acc13139..c736656d9b 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -61,6 +61,31 @@ config VIDEO_LOGO
 	  tools/logos/u-boot_logo.bmp and looks best when the display has a
 	  black background.
 
+config VIDEO_LOGO_FILE
+	string "Bitmap file used as the logo"
+	depends on VIDEO_LOGO
+	default ""
+	help
+	  Path of a BMP file, relative to the source tree, shown instead of
+	  the U-Boot logo. Empty means drivers/video/u_boot_logo.bmp.
+	  8-bit (RLE8 or uncompressed), 16-bit and 24-bit BMPs are accepted.
+
+config VIDEO_LOGO_X
+	int "Horizontal position of the logo"
+	depends on VIDEO_LOGO
+	default -4
+	help
+	  Left edge of the logo in pixels. A negative value counts from the
+	  right edge (-4 leaves a 3-pixel margin); 32767 centres the logo.
+
+config VIDEO_LOGO_Y
+	int "Vertical position of the logo"
+	depends on VIDEO_LOGO
+	default 4
+	help
+	  Top edge of the logo in pixels. A negative value counts from the
+	  bottom edge; 32767 centres the logo.
+
 config BACKLIGHT
 	bool "Enable panel backlight uclass support"
 	default y
diff --git a/drivers/video/Makefile b/drivers/video/Makefile
index 082b896798..ac424956ed 100644
--- a/drivers/video/Makefile
+++ b/drivers/video/Makefile
@@ -25,6 +25,27 @@ obj-$(CONFIG_PANEL_HX8238D) += hx8238d.o
 obj-$(CONFIG_$(PHASE_)SIMPLE_PANEL) += simple_panel.o
 
 obj-$(CONFIG_VIDEO_LOGO) += u_boot_logo.bmp.o
+
+# A board can replace the logo with CONFIG_VIDEO_LOGO_FILE. The object keeps
+# the u_boot_logo name so show_splash() finds it.
+logo-file := $(patsubst "%",%,$(CONFIG_VIDEO_LOGO_FILE))
+ifneq ($(logo-file),)
+quiet_cmd_S_logo = LOGO    $@
+cmd_S_logo =						\
+(							\
+	echo '.section .rodata.splash.init,"a"';	\
+	echo '.balign 16';				\
+	echo '.global __splash_u_boot_logo_begin';	\
+	echo '__splash_u_boot_logo_begin:';		\
+	echo '.incbin "$<" ';				\
+	echo '__splash_u_boot_logo_end:';		\
+	echo '.global __splash_u_boot_logo_end';	\
+	echo '.balign 16';				\
+) > $@
+
+$(obj)/u_boot_logo.bmp.S: $(srctree)/$(logo-file) FORCE
+	$(call if_changed,S_logo)
+endif
 obj-$(CONFIG_$(PHASE_)BMP) += bmp.o
 
 endif
diff --git a/drivers/video/video-uclass.c b/drivers/video/video-uclass.c
index 228d6bacc5..66884c84c8 100644
--- a/drivers/video/video-uclass.c
+++ b/drivers/video/video-uclass.c
@@ -597,7 +597,8 @@ static int show_splash(struct udevice *dev)
 	u8 *data = SPLASH_START(u_boot_logo);
 	int ret;
 
-	ret = video_bmp_display(dev, map_to_sysmem(data), -4, 4, true);
+	ret = video_bmp_display(dev, map_to_sysmem(data), CONFIG_VIDEO_LOGO_X,
+				CONFIG_VIDEO_LOGO_Y, true);
 
 	return 0;
 }
