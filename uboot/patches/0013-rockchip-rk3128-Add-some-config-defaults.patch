From f2869db98b6ee8aaa8cd3f8a2c7d8be832017c77 Mon Sep 17 00:00:00 2001
From: Alex Bee <knaerzche@gmail.com>
Date: Mon, 10 Feb 2025 14:21:55 +0100
Subject: [PATCH 13/46] rockchip: rk3128: Add some config defaults

In order to reduce the size of defconfig when more boards get added for
this SoC provide Kconfig defaults.

Signed-off-by: Alex Bee <knaerzche@gmail.com>
---
 arch/arm/mach-rockchip/Kconfig        | 13 +++++++++++++
 arch/arm/mach-rockchip/rk3128/Kconfig |  5 ++++-
 configs/evb-rk3128_defconfig          | 10 ----------
 3 files changed, 17 insertions(+), 11 deletions(-)

diff --git a/arch/arm/mach-rockchip/Kconfig b/arch/arm/mach-rockchip/Kconfig
index 3665322ca1..576207aa24 100644
--- a/arch/arm/mach-rockchip/Kconfig
+++ b/arch/arm/mach-rockchip/Kconfig
@@ -65,10 +65,23 @@ config ROCKCHIP_RK3066
 config ROCKCHIP_RK3128
 	bool "Support Rockchip RK3128"
 	select CPU_V7A
+	select BOARD_LATE_INIT
+	select CLK
+	select DM_REGULATOR_FIXED
+	select DM_RESET
+	select FIT
+	select HAS_CUSTOM_SYS_INIT_SP_ADDR
+	select PINCTRL
+	select RAM
+	select REGMAP
+	select SYSCON
+	select SYS_ARCH_TIMER
+	imply BOOTSTD_FULL
 	imply MISC
 	imply MISC_INIT_R
 	imply ROCKCHIP_EFUSE
 	imply ROCKCHIP_COMMON_BOARD
+	imply SKIP_LOWLEVEL_INIT
 	imply OF_UPSTREAM
 	help
 	  The Rockchip RK3128 is a ARM-based SoC with a quad-core Cortex-A7
diff --git a/arch/arm/mach-rockchip/rk3128/Kconfig b/arch/arm/mach-rockchip/rk3128/Kconfig
index 9cc494eb40..beac91845e 100644
--- a/arch/arm/mach-rockchip/rk3128/Kconfig
+++ b/arch/arm/mach-rockchip/rk3128/Kconfig
@@ -23,7 +23,10 @@ config SYS_SOC
 	default "rk3128"
 
 config SYS_MALLOC_F_LEN
-	default 0x0800
+	default 0x10000
+
+config CUSTOM_SYS_INIT_SP_ADDR
+	default 0x63f00000
 
 source "board/rockchip/evb_rk3128/Kconfig"
 
diff --git a/configs/evb-rk3128_defconfig b/configs/evb-rk3128_defconfig
index 0f0c760f06..28e69a1d5e 100644
--- a/configs/evb-rk3128_defconfig
+++ b/configs/evb-rk3128_defconfig
@@ -1,23 +1,16 @@
 CONFIG_ARM=y
-CONFIG_SKIP_LOWLEVEL_INIT=y
-CONFIG_SYS_ARCH_TIMER=y
 CONFIG_ARCH_ROCKCHIP=y
 CONFIG_TEXT_BASE=0x60000000
 CONFIG_NR_DRAM_BANKS=2
-CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
-CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x60100000
 CONFIG_SF_DEFAULT_SPEED=20000000
 CONFIG_ENV_OFFSET=0x0
 CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3128-evb"
-CONFIG_DM_RESET=y
 CONFIG_ROCKCHIP_RK3128=y
 CONFIG_SYS_BOOTM_LEN=0x4000000
 CONFIG_SYS_LOAD_ADDR=0x60800800
 CONFIG_DEBUG_UART_BASE=0x20068000
 CONFIG_DEBUG_UART_CLOCK=24000000
-# CONFIG_DEBUG_UART_BOARD_INIT is not set
 CONFIG_DEBUG_UART=y
-CONFIG_FIT=y
 CONFIG_DEFAULT_FDT_FILE="rockchip/rk3128-evb.dtb"
 # CONFIG_DISPLAY_CPUINFO is not set
 CONFIG_DISPLAY_BOARDINFO_LATE=y
@@ -39,10 +32,7 @@ CONFIG_SYS_I2C_ROCKCHIP=y
 CONFIG_MMC_DW=y
 CONFIG_MMC_DW_ROCKCHIP=y
 CONFIG_PHY_ROCKCHIP_INNO_USB2=y
-CONFIG_PINCTRL=y
 CONFIG_REGULATOR_PWM=y
-CONFIG_DM_REGULATOR_FIXED=y
-CONFIG_RAM=y
 CONFIG_DEBUG_UART_SHIFT=2
 CONFIG_SYS_NS16550_MEM32=y
 CONFIG_SYSRESET=y
-- 
2.47.3

