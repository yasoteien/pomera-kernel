From a3b0533ed4e9b4d12a0b9fd10d55c235db68d854 Mon Sep 17 00:00:00 2001
From: joshua stein <jcs@jcs.org>
Date: Tue, 24 Feb 2026 10:24:31 -0600
Subject: [PATCH 21/46] rockchip: Add pomera-dm250, config based on xpi-3128

---
 arch/arm/mach-rockchip/sdram.c |  9 +++++
 configs/pomera-dm250_defconfig | 66 ++++++++++++++++++++++++++++++++++
 dts/Makefile                   | 19 +++++-----
 scripts/Makefile.lib           |  2 +-
 4 files changed, 86 insertions(+), 10 deletions(-)
 create mode 100644 configs/pomera-dm250_defconfig

diff --git a/arch/arm/mach-rockchip/sdram.c b/arch/arm/mach-rockchip/sdram.c
index ea0e3621af..10bad7ccae 100644
--- a/arch/arm/mach-rockchip/sdram.c
+++ b/arch/arm/mach-rockchip/sdram.c
@@ -109,6 +109,10 @@ static int rockchip_dram_init_banksize(void)
 	u32 calc_hash;
 	u8 i, j;
 
+gd->bd->bi_dram[0].start = 0x60000000;
+gd->bd->bi_dram[0].size = SZ_1G;
+return 0;
+
 	if (!IS_ENABLED(CONFIG_ROCKCHIP_RK3588) &&
 	    !IS_ENABLED(CONFIG_ROCKCHIP_RK3576) &&
 	    !IS_ENABLED(CONFIG_ROCKCHIP_RK3568) &&
@@ -492,6 +496,11 @@ int dram_init(void)
 
 	ret = uclass_get_device(UCLASS_RAM, 0, &dev);
 	if (ret) {
+		if (ret == -ENODEV) {
+			gd->ram_base = 0x60000000;
+			gd->ram_size = SZ_1G;
+			return 0;
+		}
 		debug("DRAM init failed: %d\n", ret);
 		return ret;
 	}
diff --git a/configs/pomera-dm250_defconfig b/configs/pomera-dm250_defconfig
new file mode 100644
index 0000000000..08b0f4a70f
--- /dev/null
+++ b/configs/pomera-dm250_defconfig
@@ -0,0 +1,66 @@
+CONFIG_ARM=y
+CONFIG_ARCH_ROCKCHIP=y
+CONFIG_TEXT_BASE=0x60000000
+CONFIG_NR_DRAM_BANKS=2
+CONFIG_SF_DEFAULT_SPEED=20000000
+CONFIG_ENV_OFFSET=0x0
+CONFIG_DEFAULT_DEVICE_TREE="rockchip/pomera-dm250"
+CONFIG_ROCKCHIP_RK3128=y
+CONFIG_SYS_BOOTM_LEN=0x4000000
+CONFIG_SYS_LOAD_ADDR=0x60800800
+CONFIG_DEBUG_UART_BASE=0x20064000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_DEBUG_UART=y
+CONFIG_BOOTDELAY=1
+CONFIG_DEFAULT_FDT_FILE="rockchip/pomera-dm250.dtb"
+# CONFIG_DISPLAY_CPUINFO is not set
+CONFIG_DISPLAY_BOARDINFO_LATE=y
+CONFIG_CMD_GPT=y
+CONFIG_CMD_I2C=y
+CONFIG_CMD_MMC=y
+CONFIG_CMD_USB=y
+CONFIG_CMD_ROCKUSB=y
+CONFIG_CMD_USB_MASS_STORAGE=y
+# CONFIG_CMD_SETEXPR is not set
+CONFIG_CMD_TIME=y
+CONFIG_OF_EMBED=y
+CONFIG_ENV_IS_IN_MMC=y
+CONFIG_SYS_RELOC_GD_ENV_ADDR=y
+CONFIG_FASTBOOT_BUF_ADDR=0x60800800
+CONFIG_FASTBOOT_BUF_SIZE=0x04000000
+CONFIG_FASTBOOT_CMD_OEM_FORMAT=y
+CONFIG_ROCKCHIP_GPIO=y
+CONFIG_SYS_I2C_ROCKCHIP=y
+# CONFIG_ROCKCHIP_EFUSE is not set
+CONFIG_MMC_DW=y
+CONFIG_MMC_DW_ROCKCHIP=y
+CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
+CONFIG_PHY_ROCKCHIP_INNO_USB2=y
+CONFIG_DM_PMIC=y
+CONFIG_PMIC_RK8XX=y
+CONFIG_REGULATOR_PWM=y
+CONFIG_REGULATOR_RK8XX=y
+CONFIG_PWM_ROCKCHIP=y
+CONFIG_VIDEO=y
+CONFIG_DISPLAY=y
+CONFIG_VIDEO_ROCKCHIP=y
+CONFIG_VIDEO_ROCKCHIP_MAX_XRES=1024
+CONFIG_VIDEO_ROCKCHIP_MAX_YRES=600
+CONFIG_DISPLAY_ROCKCHIP_LVDS=y
+CONFIG_BACKLIGHT_PWM=y
+CONFIG_PANEL=y
+CONFIG_SIMPLE_PANEL=y
+# CONFIG_CONSOLE_MUX is not set
+# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
+CONFIG_DEBUG_UART_SHIFT=2
+CONFIG_SYS_NS16550_MEM32=y
+CONFIG_SYSRESET=y
+CONFIG_USB=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_EHCI_GENERIC=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_OHCI_GENERIC=y
+CONFIG_USB_DWC2=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_GADGET_DWC2_OTG=y
+CONFIG_USB_FUNCTION_ROCKUSB=y
diff --git a/dts/Makefile b/dts/Makefile
index befc6de180..b15c74ea49 100644
--- a/dts/Makefile
+++ b/dts/Makefile
@@ -50,18 +50,19 @@ endif
 
 targets += dt.dtb
 
-$(DTB): arch-dtbs $(local_dtbos)
-	$(Q)test -e $@ || (						\
-	echo >&2;							\
-	echo >&2 "Device Tree Source ($@) is not correctly specified.";	\
-	echo >&2 "Please define 'CONFIG_DEFAULT_DEVICE_TREE'";		\
-	echo >&2 "or build with 'DEVICE_TREE=<device_tree>' argument";	\
-	echo >&2;							\
-	/bin/false)
+$(DTB):
+#$(DTB): arch-dtbs $(local_dtbos)
+#	$(Q)test -e $@ || (						\
+#	echo >&2;							\
+#	echo >&2 "Device Tree Source ($@) is not correctly specified.";	\
+#	echo >&2 "Please define 'CONFIG_DEFAULT_DEVICE_TREE'";		\
+#	echo >&2 "or build with 'DEVICE_TREE=<device_tree>' argument";	\
+#	echo >&2;							\
+#	/bin/false)
 
 PHONY += arch-dtbs
 arch-dtbs:
-	$(Q)$(MAKE) $(build)=$(dt_dir) dtbs
+	#$(Q)$(MAKE) $(build)=$(dt_dir) dtbs
 
 ifneq ($(CONFIG_OF_UPSTREAM_INCLUDE_LOCAL_FALLBACK_DTBOS),)
 PHONY += local-dtbos
diff --git a/scripts/Makefile.lib b/scripts/Makefile.lib
index d66f1ed13b..e2f45a5443 100644
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -473,7 +473,7 @@ quiet_cmd_dtb = $(quiet_cmd_dtc)
 endif
 
 $(obj)/%.dtb: $(src)/%.dts $(DTC) $(dtsi_include_list_deps) $(DT_TMP_SCHEMA) FORCE
-	$(call if_changed_dep,dtb)
+#	$(call if_changed_dep,dtb)
 
 pre-tmp = $(subst $(comma),_,$(dot-target).pre.tmp)
 dtc-tmp = $(subst $(comma),_,$(dot-target).dts.tmp)
-- 
