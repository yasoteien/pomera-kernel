diff --git a/drivers/input/tc3589x_keyb.c b/drivers/input/tc3589x_keyb.c
index eda1dcbde6..974d6066af 100644
--- a/drivers/input/tc3589x_keyb.c
+++ b/drivers/input/tc3589x_keyb.c
@@ -5,6 +5,7 @@
  * Copyright (c) 2026 joshua stein <jcs@jcs.org>
  */
 
+#include <button.h>
 #include <dm.h>
 #include <i2c.h>
 #include <input.h>
@@ -79,12 +80,26 @@ struct tc3589x_keyb_priv {
 	u16 states[TC3589x_MAX_ROWS + 1];
 };
 
+/*
+ * Modifier keys that are not in the TC3589x matrix but wired to GPIOs
+ * (gpio-keys buttons). They are read as one extra row after the matrix.
+ */
+static const char * const tc3589x_button_labels[] = {
+	"Left Alt", "Left Control", "Left Shift", "Right Shift", "Home",
+};
+
+static const u16 tc3589x_button_codes[] = {
+	KEY_LEFTALT, KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_RIGHTSHIFT, KEY_HOME,
+};
+
 static int tc3589x_read_keys(struct input_config *input)
 {
 	struct udevice *dev = input->dev;
 	struct tc3589x_keyb_priv *priv = dev_get_priv(dev);
 	u16 new_states[TC3589x_MAX_ROWS + 1] = { 0 };
+	struct udevice *button;
 	int col, row, i, was, now, code, ret;
+	u16 buttons = 0;
 	u8 k;
 
 	/* clear keyboard interrupt before reading keys */
@@ -103,16 +118,33 @@ static int tc3589x_read_keys(struct input_config *input)
 		row = (k & TC3589x_KBDCODE_ROW_MASK) >>
 		    TC3589x_KBDCODE_ROW_SHIFT;
 		col = k & TC3589x_KBDCODE_COL_MASK;
+		if (row >= priv->rows || col >= priv->cols)
+			continue;
 		new_states[row] |= (1 << col);
 	}
 
+	/* the GPIO modifier keys become the row after the matrix */
+	for (i = 0; i < ARRAY_SIZE(tc3589x_button_labels); i++) {
+		if (button_get_by_label(tc3589x_button_labels[i], &button))
+			continue;
+		if (button_get_state(button) == BUTTON_ON)
+			buttons |= 1 << i;
+	}
+	new_states[priv->rows] = buttons;
+
 	/* collect state changes */
-	for (row = 0; row < priv->rows; row++) {
+	for (row = 0; row <= priv->rows; row++) {
 		for (col = 0; col < priv->cols; col++) {
 			was = priv->states[row] & (1 << col);
 			now = new_states[row] & (1 << col);
 
-			code = priv->keymap[row][col];
+			if (row == priv->rows) {
+				if (col >= ARRAY_SIZE(tc3589x_button_codes))
+					continue;
+				code = tc3589x_button_codes[col];
+			} else {
+				code = priv->keymap[row][col];
+			}
 			if (code == 0)
 				continue;
 
@@ -277,7 +309,9 @@ static int tc3589x_keyb_probe(struct udevice *dev)
 	/* set up input layer */
 	input->dev = dev;
 	input->read_keys = tc3589x_read_keys;
-	input_add_tables(input, false);
+	ret = input_add_tables(input, false);
+	if (ret)
+		return ret;
 
 	strcpy(sdev->name, "tc3589x-keyb");
 	ret = input_stdio_register(sdev);
