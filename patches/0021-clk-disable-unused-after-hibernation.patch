From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] clk: Turn off unused clocks again after a hibernation image is restored

After a hibernation image is restored, the gates are as the boot
loader and the kernel that loaded the image left them, not as this
kernel left them: clocks this kernel turned off as unused at boot may
be running again. Turn off the unused ones again on
PM_POST_HIBERNATION, by the same rules as at boot. The body of
clk_disable_unused() is moved to __clk_disable_unused(), which is not
__init. PM_POST_HIBERNATION is also sent when entering hibernation
fails; then the unused clocks are already off and nothing changes.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
--- a/drivers/clk/clk.c	2026-11-04 00:00:49.805065443 +0900
+++ b/drivers/clk/clk.c	2026-11-04 00:00:49.833064934 +0900
@@ -24,6 +24,7 @@
 #include <linux/spinlock.h>
 #include <linux/string.h>
 #include <linux/stringhash.h>
+#include <linux/suspend.h>
 
 #include "clk.h"
 
@@ -1442,7 +1443,7 @@
 	clk_core_unprepare_lock(core);
 }
 
-static void __init clk_unprepare_unused_subtree(struct clk_core *core)
+static void clk_unprepare_unused_subtree(struct clk_core *core)
 {
 	struct clk_core *child;
 
@@ -1467,7 +1468,7 @@
 	}
 }
 
-static void __init clk_disable_unused_subtree(struct clk_core *core)
+static void clk_disable_unused_subtree(struct clk_core *core)
 {
 	struct clk_core *child;
 	unsigned long flags;
@@ -1508,7 +1509,7 @@
 		clk_core_disable_unprepare(core->parent);
 }
 
-static bool clk_ignore_unused __initdata;
+static bool clk_ignore_unused __ro_after_init;
 static int __init clk_ignore_unused_setup(char *__unused)
 {
 	clk_ignore_unused = true;
@@ -1516,18 +1517,11 @@
 }
 __setup("clk_ignore_unused", clk_ignore_unused_setup);
 
-static int __init clk_disable_unused(void)
+static int __clk_disable_unused(void)
 {
 	struct clk_core *core;
 	int ret;
 
-	if (clk_ignore_unused) {
-		pr_warn("clk: Not disabling unused clocks\n");
-		return 0;
-	}
-
-	pr_info("clk: Disabling unused clocks\n");
-
 	ret = clk_pm_runtime_get_all();
 	if (ret)
 		return ret;
@@ -1555,6 +1549,49 @@
 
 	return 0;
 }
+
+#ifdef CONFIG_HIBERNATION
+/*
+ * After a hibernation image is restored, the gates are as the boot loader
+ * and the kernel that loaded the image left them, not as this kernel left
+ * them: clocks this kernel turned off as unused at boot may be running
+ * again.  Turn off the unused ones again, by the same rules as at boot.
+ * PM_POST_HIBERNATION is also sent when entering hibernation fails; then
+ * the unused clocks are already off and nothing changes.
+ */
+static int clk_hibernation_notify(struct notifier_block *nb,
+				  unsigned long action, void *data)
+{
+	if (action == PM_POST_HIBERNATION) {
+		pr_info("clk: Disabling unused clocks after hibernation\n");
+		__clk_disable_unused();
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block clk_hibernation_nb = {
+	.notifier_call = clk_hibernation_notify,
+};
+#endif
+
+static int __init clk_disable_unused(void)
+{
+	int ret;
+
+	if (clk_ignore_unused) {
+		pr_warn("clk: Not disabling unused clocks\n");
+		return 0;
+	}
+
+	pr_info("clk: Disabling unused clocks\n");
+
+	ret = __clk_disable_unused();
+#ifdef CONFIG_HIBERNATION
+	if (!ret)
+		register_pm_notifier(&clk_hibernation_nb);
+#endif
+	return ret;
+}
 late_initcall_sync(clk_disable_unused);
 
 static int clk_core_determine_round_nolock(struct clk_core *core,
