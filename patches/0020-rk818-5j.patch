-		if (active)
-			dev_info(ch->dev, "powered hub: raising the USB input limit step by step\n");
+	if (active != ch->hub_active) {
+		ch->hub_active = active;
 		ret = rk818_update_input(ch);
-		goto unlock;
-	}
-	if (!active)
-		goto unlock;
-
-	top = rk818_ramp_top(ch);
-	if (ch->ramp_ok > top || ch->ramp_try > top) {
