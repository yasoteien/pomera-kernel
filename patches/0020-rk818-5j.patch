@@ -983,8 +944,8 @@
 }
 
 /*
- * DCP: the DT limit, CDP: at most 1.5 A, a powered hub: the step of the
- * ramp, anything else: 450 mA. Called under ilim_lock.
+ * DCP: the DT limit, CDP: at most 1.5 A, a powered hub: unknown_max_ua,
+ * anything else: 450 mA. Called under ilim_lock.
