 	return ret ?: err;
 }
 
-/* Back to 450 mA; also forgets the steps tried so far */
-static void rk818_ramp_reset(struct rk818_charger *ch)
-{
-	ch->ramp_gen++;
-	ch->ramp_phase = RK818_RAMP_IDLE;
-	ch->ramp_ok = 0;
-	ch->ramp_try = -1;
-	ch->ramp_raised = 0;
-	ch->ramp_fails = 0;
-	ch->ramp_hold = false;
-	ch->ramp_wait = RK818_RAMP_WAIT_NONE;
-}
-
-static void rk818_ramp_waiting(struct rk818_charger *ch, enum rk818_ramp_wait wait)
-{
-	static const char * const why[] = {
-		[RK818_RAMP_WAIT_LOAD] = "the load is moving",
-		[RK818_RAMP_WAIT_FULL] = "the battery takes no more current",
-	};
-
-	if (wait == ch->ramp_wait)
-		return;
-	ch->ramp_wait = wait;
-	if (wait != RK818_RAMP_WAIT_NONE)
-		dev_info(ch->dev, "USB input limit stays at %d mA: %s\n",
-			 rk818_ramp_ua(ch->ramp_ok) / 1000, why[wait]);
-}
-
-static int rk818_ramp_top(struct rk818_charger *ch)
-{
-	int max = READ_ONCE(unknown_max_ua);
-	int top = 0, i;
-
-	for (i = 0; i < ARRAY_SIZE(rk818_ramp_sel); i++)
-		if (rk818_ramp_ua(i) <= max)
-			top = i;
-	if (ch->ramp_cap >= 0 && time_before(jiffies, ch->ramp_cap_until))
-		top = min(top, ch->ramp_cap);
-	return top;
-}
-
-/* Back to the confirmed step; never below it */
-static void rk818_ramp_undo(struct rk818_charger *ch, bool failed)
-{
-	int ua = rk818_ramp_ua(ch->ramp_try);
-
-	ch->ramp_try = -1;
-	ch->ramp_phase = RK818_RAMP_IDLE;
-	if (!failed || ++ch->ramp_fails < RK818_RAMP_FAILS)
-		return;
-
-	/* After the hold one failure is enough to hold again */
-	ch->ramp_fails = RK818_RAMP_FAILS - 1;
-	ch->ramp_hold = true;
-	ch->ramp_hold_until = jiffies + msecs_to_jiffies(RK818_RAMP_HOLD_MS);
-	dev_info(ch->dev, "USB input limit held at %d mA: no current gain at %d mA\n",
-		 rk818_ramp_ua(ch->ramp_ok) / 1000, ua / 1000);
-}
-
-/* Median of a few battery current readings, and their spread */
-static int rk818_sample_current(struct rk818_charger *ch, int *median,
-				int *spread)
-{
-	int val[RK818_RAMP_SAMPLES];
-	int i, j, ret;
-
-	for (i = 0; i < ARRAY_SIZE(val); i++) {
-		if (i)
-			msleep(RK818_RAMP_SAMPLE_MS);
-		ret = rk818_read_current(ch, &val[i]);
-		if (ret)
-			return ret;
-	}
-
-	for (i = 1; i < ARRAY_SIZE(val); i++)
-		for (j = i; j > 0 && val[j - 1] > val[j]; j--)
-			swap(val[j - 1], val[j]);
-
-	*median = val[ARRAY_SIZE(val) / 2];
-	*spread = val[ARRAY_SIZE(val) - 1] - val[0];
-	return 0;
-}
-
 /*
- * Whether the battery could take more current than it gets now. The
- * voltage is not used: while charging it reads well above the open circuit
- * voltage. Near CV a step simply shows no gain and is undone.
+ * The USB PHY cannot tell what a powered hub is fed from. A hub with its
+ * own supply charges the DM250 like a charger, so it gets the full limit
+ * at once. The battery current is not used to find a lower limit: near
+ * full it does not grow with the limit, and such a search stayed at
+ * 450 mA below the consumption of the DM250 itself.
  */
-static int rk818_ramp_demand(struct rk818_charger *ch, int ua, bool *demand)
+static void rk818_hub_work(struct work_struct *work)
 {
-	unsigned int sup;
+	struct rk818_charger *ch = container_of(to_delayed_work(work),
+						struct rk818_charger, hub_work);
+	bool plugged = false, active;
 	int ret;
 
-	ret = regmap_read(ch->regmap, RK818_SUP_STS_REG, &sup);
-	if (ret)
-		return ret;
-
-	*demand = ua < 0 ||
-		  (FIELD_GET(RK818_SUP_STS_CHG_STS, sup) != RK818_CHG_TERM &&
-		   ua < ch->cc_ua - RK818_RAMP_CC_MARGIN_UA);
-	return 0;
-}
-
-/*
- * The USB PHY cannot tell what a powered hub is fed from, so the input
- * limit is raised one step at a time while the battery current follows
- * it. A step is kept only when the battery current has grown by half of
- * the step twice in a row. Anything else, a load that moves under the
- * readings included, takes the step back to the last confirmed one.
- */
-static void rk818_ramp_work(struct work_struct *work)
-{
-	struct rk818_charger *ch = container_of(to_delayed_work(work),
-						struct rk818_charger, ramp_work);
-	enum rk818_ramp_phase want;
-	bool plugged = false, active, demand = false;
-	int cur = 0, spread = 0, delta, top, ret;
-	unsigned int gen;
-
 	ret = rk818_plugged(ch, &plugged);
 	if (!ret && !plugged) {
 		mutex_lock(&ch->ilim_lock);
-		ch->ramp_active = false;
-		rk818_ramp_reset(ch);
+		ch->hub_active = false;
 		mutex_unlock(&ch->ilim_lock);
 		/* The plug-in interrupt starts it again */
 		return;
@@ -1153,114 +1007,24 @@
 		 rk818_hub_seen();
 
 	mutex_lock(&ch->ilim_lock);
