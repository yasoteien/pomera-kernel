From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] power: supply: rk818: Full input limit on a powered hub at once

Give a powered hub the full input limit at once instead of step by
step, and report discharging while plugged in when the battery
current is negative.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -7,8 +7,9 @@
  * vendor kernel of that device, so that both kernels can be booted on
  * one machine without upsetting each other's state of charge.
  *
- * Stage 5i: as 5h, with red and green in turn when plugged in but
- * discharging, and red blinking on a low battery while unplugged.
+ * Stage 5j: as 5i, with a powered hub given the full input limit at once
+ * instead of step by step, and "discharging" reported while plugged in
+ * when the battery current is negative.
  */
 
 #include <linux/bitfield.h>
@@ -104,22 +105,12 @@
 #define RK818_FORCE_SYNC_MS		3000
 #define RK818_FORCE_RETRY_MS		5000
 
-/* Raising the USB input limit on a powered hub, one step per try */
-#define RK818_RAMP_TICK_MS		1000
-#define RK818_RAMP_SETTLE_MS		2000
-#define RK818_RAMP_SAMPLES		5
-#define RK818_RAMP_SAMPLE_MS		200
-/* Samples spread wider than this: the load moved, no decision */
-#define RK818_RAMP_SPREAD_UA		150000
-/* Undone this many times in a row: stay for a while, then try once more */
-#define RK818_RAMP_FAILS		3
-#define RK818_RAMP_HOLD_MS		(5 * 60 * 1000)
-/* A plug-out this soon after a raise caps the ramp for a while */
-#define RK818_RAMP_DROP_MS		10000
-#define RK818_RAMP_CAP_MS		60000
-/* The battery takes no more current near the charge current */
-#define RK818_RAMP_CC_MARGIN_UA		200000
+/* How often the port is looked at for a powered hub while plugged in */
+#define RK818_HUB_TICK_MS		1000
 
+/* Plugged in but below this battery current: reported as discharging */
+#define RK818_DISCHARGE_UA		(-50000)
+
 #define RK818_LED_MS			500
 /* Low battery LED: at or below this capacity while unplugged (%, 0: off) */
 #define RK818_LOW_LED_PCT		10
@@ -222,19 +213,8 @@
 };
 
