-				goto unlock;
-			ch->ramp_hold = false;
-		}
-		break;
-	case RK818_RAMP_SETTLE:
-		if (time_before(jiffies, ch->ramp_since +
-				msecs_to_jiffies(RK818_RAMP_SETTLE_MS)))
-			goto unlock;
-		break;
-	case RK818_RAMP_CONFIRM:
-		break;
-	}
-	gen = ch->ramp_gen;
-	mutex_unlock(&ch->ilim_lock);
-
-	ret = rk818_sample_current(ch, &cur, &spread);
-	if (!ret && want == RK818_RAMP_IDLE)
-		ret = rk818_ramp_demand(ch, cur, &demand);
-
-	mutex_lock(&ch->ilim_lock);
-	if (gen != ch->ramp_gen || !ch->ramp_active || want != ch->ramp_phase)
-		goto unlock;
-
-	if (want == RK818_RAMP_IDLE) {
-		if (ret)
-			goto unlock;
-		if (spread > RK818_RAMP_SPREAD_UA) {
-			rk818_ramp_waiting(ch, RK818_RAMP_WAIT_LOAD);
