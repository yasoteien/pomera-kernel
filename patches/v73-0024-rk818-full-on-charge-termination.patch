From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] power: supply: rk818: Report full on charge termination with a small discharge

After the charge terminates, the charger starts again only when the
battery falls 150 mV below the charge voltage, and until then the
battery may supply part of the load (about 80 mA was seen on a powered
hub). The status then read Discharging, the LEDs showed red and green
in turn, and the fuel gauge was never set to full, as that needed a
current of at least zero.

With the charge terminated and the battery within 150 mV of the charge
voltage, report Full and set the counter to full once per termination,
whatever the current. Discharging below -50 mA is now reported only
while charging. The LEDs follow the battery status.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
diff --git a/drivers/power/supply/rk818_charger.c b/drivers/power/supply/rk818_charger.c
index 394157925c54..a09d4df450ff 100644
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -113,6 +113,13 @@
 /* Plugged in but below this battery current: reported as discharging */
 #define RK818_DISCHARGE_UA		(-50000)
 
+/*
+ * Charge terminated and the battery within this of the charge voltage:
+ * full. The charger starts again only 150 mV below the charge voltage
+ * (VRECH), and until then the battery may supply part of the load.
+ */
+#define RK818_FULL_MARGIN_UV		150000
+
 #define RK818_LED_MS			500
 /* Low battery LED: at or below this capacity while unplugged (%, 0: off) */
 #define RK818_LOW_LED_PCT		10
@@ -319,6 +326,8 @@ struct rk818_charger {
 	int saved_soc;
 	bool neg_cnt;
 	unsigned long neg_cnt_since;
+	/* The counter was set to full for this charge termination */
+	bool term_full;
 	bool low_volt;
 	unsigned long low_volt_since;
 	int shutdown_uv;
@@ -623,6 +632,12 @@ static bool rk818_low_battery(struct rk818_charger *ch, int uv, int ua,
 	return (ua < 0 || (!plugged && ua == 0)) && uv < ch->shutdown_uv;
 }
 
+static bool rk818_term_full(struct rk818_charger *ch, unsigned int sup, int uv)
+{
+	return FIELD_GET(RK818_SUP_STS_CHG_STS, sup) == RK818_CHG_TERM &&
+	       uv >= ch->cv_uv - RK818_FULL_MARGIN_UV;
+}
+
 static int rk818_gauge_update(struct rk818_charger *ch)
 {
 	unsigned int sup, mon;
@@ -667,10 +682,15 @@ static int rk818_gauge_update(struct rk818_charger *ch)
 		return ret;
 	uah = rk818_cnt_to_uah(cnt);
 
-	/* Charge terminated near the charge voltage: the battery is full */
-	if (plugged && ua >= 0 &&
-	    FIELD_GET(RK818_SUP_STS_CHG_STS, sup) == RK818_CHG_TERM &&
-	    uv >= ch->cv_uv - 150000) {
+	/*
+	 * Charge terminated near the charge voltage: the battery is full.
+	 * Set once per termination, even with a small discharge current
+	 * then; afterwards the counter counts down as usual.
+	 */
+	if (!plugged || !rk818_term_full(ch, sup, uv)) {
+		ch->term_full = false;
+	} else if (!ch->term_full) {
+		ch->term_full = true;
 		if (uah != full) {
 			ret = rk818_write_gascnt(ch, full);
 			if (ret)
@@ -716,7 +736,7 @@ static int rk818_bat_status(struct rk818_charger *ch, int *status)
 {
 	unsigned int sup;
 	bool plugged;
-	int ua, ret;
+	int uv, ua, ret;
 
 	if (READ_ONCE(ch->dead)) {
 		*status = POWER_SUPPLY_STATUS_DISCHARGING;
@@ -739,11 +759,20 @@ static int rk818_bat_status(struct rk818_charger *ch, int *status)
 	case RK818_CHG_OFF:
 		*status = POWER_SUPPLY_STATUS_NOT_CHARGING;
 		break;
+	case RK818_CHG_TERM:
+		/* Until the charger starts again, the battery may help the input */
+		ret = rk818_read_voltage(ch, &uv);
+		if (ret)
+			return ret;
+		if (rk818_term_full(ch, sup, uv)) {
+			*status = POWER_SUPPLY_STATUS_FULL;
+			break;
+		}
+		fallthrough;
 	case RK818_CHG_WAKEUP:
 	case RK818_CHG_TRICKLE:
 	case RK818_CHG_CC_CV:
-	case RK818_CHG_TERM:
-		/* A load above the input limit drains the battery, full or not */
+		/* A load above the input limit drains the battery */
 		ret = rk818_read_current(ch, &ua);
 		if (ret)
 			return ret;
@@ -1037,9 +1066,10 @@ static void rk818_hub_work(struct work_struct *work)
 }
 
 /*
- * The charge LEDs: red and green in turn when plugged in but discharging,
- * even when full; otherwise green when full and red while the battery
- * current is positive. While
+ * The charge LEDs, while plugged in: green when full (charge terminated,
+ * even with a small discharge current), red and green in turn when
+ * discharging (as the battery status), green at 100 %, red while the
+ * battery current is positive, otherwise red and green in turn. While
  * unplugged: off, or red blinking when the capacity is at or below
  * low_led_pct or the battery is empty. Only the blinking states keep this
  * work running; otherwise the monitor work starts it every 5 s and the
@@ -1065,15 +1095,14 @@ static void rk818_led_work(struct work_struct *work)
 		else
 			state = RK818_LED_OFF;
 	} else {
-		ret = rk818_read_current(ch, &ua);
-		/* Drained while plugged in comes first, even when full */
-		if (!ret && ua < RK818_DISCHARGE_UA)
+		ret = rk818_bat_status(ch, &status);
+		if (!ret && status == POWER_SUPPLY_STATUS_FULL)
+			state = RK818_LED_GREEN;
+		else if (!ret && status == POWER_SUPPLY_STATUS_DISCHARGING)
 			state = RK818_LED_ALTERNATE;
-		else if ((!rk818_bat_status(ch, &status) &&
-			  status == POWER_SUPPLY_STATUS_FULL) ||
-			 (!rk818_capacity(ch, &cap) && cap == 100))
+		else if (!rk818_capacity(ch, &cap) && cap == 100)
 			state = RK818_LED_GREEN;
-		else if (!ret && ua > 0)
+		else if (!rk818_read_current(ch, &ua) && ua > 0)
 			state = RK818_LED_RED;
 		else
 			state = RK818_LED_ALTERNATE;
