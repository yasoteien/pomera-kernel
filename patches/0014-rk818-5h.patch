From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] power: supply: rk818: Do not hold back the input limit ramp on voltage

Do not hold back the ramp of the USB input limit by the battery
voltage, and log a line when the ramp waits.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -7,8 +7,8 @@
  * vendor kernel of that device, so that both kernels can be booted on
  * one machine without upsetting each other's state of charge.
  *
- * Stage 5g: as 5f, plus the forced power-off after a low battery done by
- * this driver instead of the kernel's hw_protection fallback.
+ * Stage 5h: as 5g, with the ramp of the USB input limit no longer held
+ * back by the battery voltage, and a line when it waits.
  */
 
 #include <linux/bitfield.h>
@@ -117,8 +117,7 @@
 /* A plug-out this soon after a raise caps the ramp for a while */
 #define RK818_RAMP_DROP_MS		10000
 #define RK818_RAMP_CAP_MS		60000
-/* The battery takes no more current near CV or near the charge current */
-#define RK818_RAMP_CV_MARGIN_UV		100000
+/* The battery takes no more current near the charge current */
 #define RK818_RAMP_CC_MARGIN_UA		200000
 
 #define RK818_LED_MS			500
@@ -271,6 +270,13 @@
 	RK818_RAMP_CONFIRM,
 };
 
+/* Why the ramp does not try the next step; logged when it changes */
+enum rk818_ramp_wait {
+	RK818_RAMP_WAIT_NONE,
+	RK818_RAMP_WAIT_LOAD,
+	RK818_RAMP_WAIT_FULL,
+};
+
 enum rk818_led_state {
 	RK818_LED_OFF,
 	RK818_LED_GREEN,
@@ -332,6 +338,7 @@
 	int ramp_raised;	/* the step of that try, or 0 */
 	int ramp_fails;
 	bool ramp_hold;
+	enum rk818_ramp_wait ramp_wait;
 	unsigned long ramp_hold_until;
 	int ramp_cap;		/* highest step after a drop, or -1 */
 	unsigned long ramp_cap_until;
@@ -994,6 +1001,22 @@
 	ch->ramp_raised = 0;
 	ch->ramp_fails = 0;
 	ch->ramp_hold = false;
+	ch->ramp_wait = RK818_RAMP_WAIT_NONE;
+}
+
+static void rk818_ramp_waiting(struct rk818_charger *ch, enum rk818_ramp_wait wait)
+{
+	static const char * const why[] = {
+		[RK818_RAMP_WAIT_LOAD] = "the load is moving",
+		[RK818_RAMP_WAIT_FULL] = "the battery takes no more current",
+	};
+
+	if (wait == ch->ramp_wait)
+		return;
+	ch->ramp_wait = wait;
+	if (wait != RK818_RAMP_WAIT_NONE)
+		dev_info(ch->dev, "USB input limit stays at %d mA: %s\n",
+			 rk818_ramp_ua(ch->ramp_ok) / 1000, why[wait]);
 }
 
 static int rk818_ramp_top(struct rk818_charger *ch)
@@ -1051,22 +1074,22 @@
 	return 0;
 }
 
-/* Whether the battery would take more current than it gets now */
+/*
+ * Whether the battery could take more current than it gets now. The
+ * voltage is not used: while charging it reads well above the open circuit
+ * voltage. Near CV a step simply shows no gain and is undone.
+ */
 static int rk818_ramp_demand(struct rk818_charger *ch, int ua, bool *demand)
 {
 	unsigned int sup;
-	int uv, ret;
+	int ret;
 
 	ret = regmap_read(ch->regmap, RK818_SUP_STS_REG, &sup);
 	if (ret)
 		return ret;
-	ret = rk818_read_voltage(ch, &uv);
-	if (ret)
-		return ret;
 
 	*demand = ua < 0 ||
 		  (FIELD_GET(RK818_SUP_STS_CHG_STS, sup) != RK818_CHG_TERM &&
-		   uv < ch->cv_uv - RK818_RAMP_CV_MARGIN_UV &&
 		   ua < ch->cc_ua - RK818_RAMP_CC_MARGIN_UA);
 	return 0;
 }
@@ -1154,8 +1177,17 @@
 		goto unlock;
 
 	if (want == RK818_RAMP_IDLE) {
-		if (ret || spread > RK818_RAMP_SPREAD_UA || !demand)
+		if (ret)
+			goto unlock;
+		if (spread > RK818_RAMP_SPREAD_UA) {
+			rk818_ramp_waiting(ch, RK818_RAMP_WAIT_LOAD);
 			goto unlock;
+		}
+		if (!demand) {
+			rk818_ramp_waiting(ch, RK818_RAMP_WAIT_FULL);
+			goto unlock;
+		}
+		rk818_ramp_waiting(ch, RK818_RAMP_WAIT_NONE);
 		ch->ramp_base_ua = cur;
 		ch->ramp_try = ch->ramp_ok + 1;
 		ch->ramp_phase = RK818_RAMP_SETTLE;
@@ -1165,9 +1197,16 @@
 		goto unlock;
 	}
 
+	/*
+	 * The gain is signed: a battery that was helping a heavy load out
+	 * (negative current) and needs less of it after the step shows the
+	 * same gain as a charge current that grows.
+	 */
 	delta = rk818_ramp_ua(ch->ramp_try) - rk818_ramp_ua(ch->ramp_ok);
 	if (ret || spread > RK818_RAMP_SPREAD_UA) {
 		/* No decision: the readings failed or the load moved */
+		if (!ret)
+			rk818_ramp_waiting(ch, RK818_RAMP_WAIT_LOAD);
 		rk818_ramp_undo(ch, false);
 	} else if (cur - ch->ramp_base_ua < delta / 2) {
 		rk818_ramp_undo(ch, true);
