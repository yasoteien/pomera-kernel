From fc969feaae1bbd8659ca7ba53073ef13ba6a3358 Mon Sep 17 00:00:00 2001
From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Date: Wed, 18 Nov 2026 18:31:13 +0900
Subject: [PATCH 34/35] power: supply: rk818: Keep the VB_LO mark until the
 battery is charged

The mark of the previous change was set only on battery and cleared by
any plug-in, and was lost on a restart, so a VB_LO under a weak supply,
a short plug-in or a restart left no mark, and a lid closed after the
voltage came back up could suspend. Set it on every VB_LO and whenever
VB_LO_STS shows the battery below VB_LO now, and clear it only with
power plugged in and the battery back above the shutdown voltage plus
300 mV, under the driver lock. Also refuse suspend to idle or RAM while
VB_LO_STS is set, even with power plugged in: the PMIC would not wake
the system if the power were unplugged while asleep below VB_LO.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
 drivers/power/supply/rk818_charger.c | 40 +++++++++++++++++++---------
 1 file changed, 27 insertions(+), 13 deletions(-)

diff --git a/drivers/power/supply/rk818_charger.c b/drivers/power/supply/rk818_charger.c
index 4744772bc..d9b67965a 100644
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -36,6 +36,7 @@
 #include <linux/workqueue.h>
 
 #define RK818_PLUG_IN_STS		BIT(6)	/* RK808_VB_MON_REG */
+#define RK818_VB_LO_STS			BIT(3)	/* RK808_VB_MON_REG: below VB_LO now */
 
 #define RK818_SUP_STS_BAT_EXS		BIT(7)
 #define RK818_SUP_STS_CHG_STS		GENMASK(6, 4)
@@ -368,7 +369,10 @@ struct rk818_charger {
 	int shutdown_uv;
 	/* Set once the low battery shutdown has started */
 	bool dead;
-	/* VB_LO was raised on battery; cleared when plugged in */
+	/*
+	 * VB_LO was raised or seen; under lock. Cleared only when plugged
+	 * in and the battery is back above the shutdown voltage + 300 mV.
+	 */
 	bool vb_low;
 	struct delayed_work off_work;
 
@@ -697,8 +701,10 @@ static int rk818_gauge_update(struct rk818_charger *ch)
 	if (ret)
 		return ret;
 	plugged = mon & RK818_PLUG_IN_STS;
-	if (plugged)
-		WRITE_ONCE(ch->vb_low, false);
+	if (mon & RK818_VB_LO_STS)
+		ch->vb_low = true;
+	else if (plugged && uv >= ch->shutdown_uv + RK818_VB_LOW_MARGIN_UV)
+		ch->vb_low = false;
 
 	if (rk818_low_battery(ch, uv, ua, plugged)) {
 		if (!ch->low_volt) {
@@ -1353,11 +1359,11 @@ static irqreturn_t rk818_plug_irq(int irq, void *data)
 static irqreturn_t rk818_vb_low_irq(int irq, void *data)
 {
 	struct rk818_charger *ch = data;
-	unsigned int mon;
 
-	if (!regmap_read(ch->regmap, RK808_VB_MON_REG, &mon) &&
-	    !(mon & RK818_PLUG_IN_STS))
-		WRITE_ONCE(ch->vb_low, true);
+	/* Also with power plugged in: a weak supply can still drain it */
+	mutex_lock(&ch->lock);
+	ch->vb_low = true;
+	mutex_unlock(&ch->lock);
 	mod_delayed_work(system_freezable_wq, &ch->work, 0);
 	return IRQ_HANDLED;
 }
@@ -1784,15 +1790,23 @@ static int rk818_charger_suspend_sleep(struct device *dev)
 	int uv;
 
 	mutex_lock(&ch->lock);
+	/*
+	 * Below VB_LO now: not even with power plugged in, as the PMIC
+	 * would not wake the system if it were unplugged while asleep.
+	 */
 	if (!ch->dead && !rk818_read_voltage(ch, &uv) &&
 	    !regmap_read(ch->regmap, RK808_VB_MON_REG, &mon) &&
-	    !(mon & RK818_PLUG_IN_STS) &&
-	    (uv < ch->shutdown_uv + RK818_SUSPEND_MARGIN_UV ||
-	     (READ_ONCE(ch->vb_low) &&
-	      uv < ch->shutdown_uv + RK818_VB_LOW_MARGIN_UV))) {
+	    ((mon & RK818_VB_LO_STS) ||
+	     (!(mon & RK818_PLUG_IN_STS) &&
+	      (uv < ch->shutdown_uv + RK818_SUSPEND_MARGIN_UV ||
+	       (ch->vb_low &&
+		uv < ch->shutdown_uv + RK818_VB_LOW_MARGIN_UV))))) {
+		bool vb_low = ch->vb_low;
+
 		mutex_unlock(&ch->lock);
-		dev_warn(dev, "battery nearly empty (%d uV%s): not suspending\n",
-			 uv, READ_ONCE(ch->vb_low) ? ", after VB_LO" : "");
+		dev_warn(dev, "battery nearly empty (%d uV%s%s): not suspending\n",
+			 uv, mon & RK818_VB_LO_STS ? ", below VB_LO" : "",
+			 vb_low ? ", after VB_LO" : "");
 		return -EBUSY;
 	}
 	mutex_unlock(&ch->lock);
-- 
