From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] power: supply: rk818: Show discharging and a low battery on the LEDs

Light red and green in turn when plugged in but discharging, and
blink red on a low battery while unplugged.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
diff --git a/drivers/power/supply/rk818_charger.c b/drivers/power/supply/rk818_charger.c
index 164082cef8a7..e04c3a002ee0 100644
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -7,8 +7,8 @@
  * vendor kernel of that device, so that both kernels can be booted on
  * one machine without upsetting each other's state of charge.
  *
- * Stage 5h: as 5g, with the ramp of the USB input limit no longer held
- * back by the battery voltage, and a line when it waits.
+ * Stage 5i: as 5h, with red and green in turn when plugged in but
+ * discharging, and red blinking on a low battery while unplugged.
  */
 
 #include <linux/bitfield.h>
@@ -121,6 +121,8 @@
 #define RK818_RAMP_CC_MARGIN_UA		200000
 
 #define RK818_LED_MS			500
+/* Low battery LED: at or below this capacity while unplugged (%, 0: off) */
+#define RK818_LOW_LED_PCT		10
 
 /*
  * Testing only: power off at this voltage instead of the battery minimum.
@@ -264,6 +266,29 @@ static const struct kernel_param_ops rk818_max_ua_ops = {
 module_param_cb(unknown_max_ua, &rk818_max_ua_ops, &unknown_max_ua, 0644);
 MODULE_PARM_DESC(unknown_max_ua, "Highest USB input limit on a powered hub (uA, 0: stay at 450 mA)");
 
+static int low_led_pct = RK818_LOW_LED_PCT;
+
+static int rk818_set_pct(const char *val, const struct kernel_param *kp)
+{
+	int pct, ret;
+
+	ret = kstrtoint(val, 0, &pct);
+	if (ret)
+		return ret;
+	if (pct < 0 || pct > 100)
+		return -EINVAL;
+
+	WRITE_ONCE(*(int *)kp->arg, pct);
+	return 0;
+}
+
+static const struct kernel_param_ops rk818_pct_ops = {
+	.set = rk818_set_pct,
+	.get = param_get_int,
+};
+module_param_cb(low_led_pct, &rk818_pct_ops, &low_led_pct, 0644);
+MODULE_PARM_DESC(low_led_pct, "Blink the red LED at or below this capacity while unplugged (%, 0: never)");
+
 enum rk818_ramp_phase {
 	RK818_RAMP_IDLE,
 	RK818_RAMP_SETTLE,
@@ -281,7 +306,10 @@ enum rk818_led_state {
 	RK818_LED_OFF,
 	RK818_LED_GREEN,
 	RK818_LED_RED,
-	RK818_LED_BLINK,
+	/* Plugged in but discharging: red and green in turn */
+	RK818_LED_ALTERNATE,
+	/* Unplugged and low, or powering off on low battery: red blinking */
+	RK818_LED_LOW,
 };
 
 struct rk818_charger {
@@ -1231,44 +1259,57 @@ static void rk818_ramp_work(struct work_struct *work)
 }
 
 /*
- * The charge LEDs, as the pdcharge service of FDTP drives them: off when
- * nothing is plugged in, green when full, red while the battery current
- * is positive, red blinking when plugged in but discharging.
+ * The charge LEDs: green when full, red while the battery current is
+ * positive, red and green in turn when plugged in but discharging. While
+ * unplugged: off, or red blinking when the capacity is at or below
+ * low_led_pct or the battery is empty. Only the blinking states keep this
+ * work running; otherwise the monitor work starts it every 5 s and the
+ * plug interrupts start it at once.
  */
 static void rk818_led_work(struct work_struct *work)
 {
 	struct rk818_charger *ch = container_of(to_delayed_work(work),
 						struct rk818_charger, led_work);
 	enum rk818_led_state state;
-	int status, cap, ua;
-	bool plugged;
+	int status, cap, ua, pct;
+	bool plugged, blink;
 
 	if (rk818_plugged(ch, &plugged))
 		goto again;
 
-	if (!plugged)
-		state = RK818_LED_OFF;
-	else if ((!rk818_bat_status(ch, &status) &&
-		  status == POWER_SUPPLY_STATUS_FULL) ||
-		 (!rk818_capacity(ch, &cap) && cap == 100))
+	if (!plugged) {
+		pct = READ_ONCE(low_led_pct);
+		/* Empty reads as 0 %: blink until the power goes */
+		if (READ_ONCE(ch->dead) ||
+		    (pct && !rk818_capacity(ch, &cap) && cap <= pct))
+			state = RK818_LED_LOW;
+		else
+			state = RK818_LED_OFF;
+	} else if ((!rk818_bat_status(ch, &status) &&
+		    status == POWER_SUPPLY_STATUS_FULL) ||
+		   (!rk818_capacity(ch, &cap) && cap == 100)) {
 		state = RK818_LED_GREEN;
-	else if (!rk818_read_current(ch, &ua) && ua > 0)
+	} else if (!rk818_read_current(ch, &ua) && ua > 0) {
 		state = RK818_LED_RED;
-	else
-		state = RK818_LED_BLINK;
+	} else {
+		state = RK818_LED_ALTERNATE;
+	}
 
-	if (state == RK818_LED_BLINK)
+	blink = state == RK818_LED_ALTERNATE || state == RK818_LED_LOW;
+	if (blink)
 		ch->led_blink_on = state != ch->led_state || !ch->led_blink_on;
-	if (state != ch->led_state || state == RK818_LED_BLINK) {
+	if (state != ch->led_state || blink) {
 		led_trigger_event(ch->led_red,
 				  state == RK818_LED_RED ||
-				  (state == RK818_LED_BLINK && ch->led_blink_on) ?
+				  (blink && ch->led_blink_on) ?
 				  LED_FULL : LED_OFF);
 		led_trigger_event(ch->led_green,
-				  state == RK818_LED_GREEN ? LED_FULL : LED_OFF);
+				  state == RK818_LED_GREEN ||
+				  (state == RK818_LED_ALTERNATE && !ch->led_blink_on) ?
+				  LED_FULL : LED_OFF);
 		ch->led_state = state;
 	}
-	/* The plug-in interrupt starts it again */
+	/* The monitor work and the plug interrupts start it again */
 	if (state == RK818_LED_OFF)
 		return;
 again:
