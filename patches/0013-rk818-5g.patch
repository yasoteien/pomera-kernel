From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] power: supply: rk818: Force the power-off after a low battery

Do the forced power-off after a low battery in this driver instead of
the kernel's hw_protection fallback.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -7,14 +7,15 @@
  * vendor kernel of that device, so that both kernels can be booted on
  * one machine without upsetting each other's state of charge.
  *
- * Stage 5f: as 5e, plus raising the USB input limit step by step on a
- * powered hub, and the triggers for the charge LEDs.
+ * Stage 5g: as 5f, plus the forced power-off after a low battery done by
+ * this driver instead of the kernel's hw_protection fallback.
  */
 
 #include <linux/bitfield.h>
 #include <linux/delay.h>
 #include <linux/devm-helpers.h>
 #include <linux/extcon.h>
+#include <linux/fs.h>
 #include <linux/interrupt.h>
 #include <linux/jiffies.h>
 #include <linux/leds.h>
@@ -95,7 +96,13 @@
 /* Below the minimum voltage for this long, or 50 mV below it: power off */
 #define RK818_LOW_VOLT_MS		60000
 #define RK818_LOW_VOLT_MARGIN_UV	50000
-#define RK818_SHUTDOWN_MS		10000
+/*
+ * After a low battery the orderly power-off gets this long; then the driver
+ * switches the PMIC off itself, after emergency_sync() and with one retry.
+ */
+#define RK818_FORCE_OFF_MS		30000
+#define RK818_FORCE_SYNC_MS		3000
+#define RK818_FORCE_RETRY_MS		5000
 
 /* Raising the USB input limit on a powered hub, one step per try */
 #define RK818_RAMP_TICK_MS		1000
@@ -146,6 +153,7 @@
 	{ RK818_DATA_TIMER_REG, 0xff },
 	{ RK818_DATA_FLAGS_REG, RK818_FLAGS_RESEED | RK818_FLAGS_RESEED_REST |
 				RK818_FLAGS_VALID },
+	{ RK818_DEVCTRL_REG, DEV_OFF },
 };
 
 /* The 32 bit registers this stage may write */
@@ -308,6 +316,7 @@
 	int shutdown_uv;
 	/* Set once the low battery shutdown has started */
 	bool dead;
+	struct delayed_work off_work;
 
 	/* The USB input limit and its ramp, under ilim_lock */
 	struct mutex ilim_lock;
@@ -610,6 +619,13 @@
 }
 
 /* Called with lock held */
+/* Discharging below the minimum voltage */
+static bool rk818_low_battery(struct rk818_charger *ch, int uv, int ua,
+			      bool plugged)
+{
+	return (ua < 0 || (!plugged && ua == 0)) && uv < ch->shutdown_uv;
+}
+
 static int rk818_gauge_update(struct rk818_charger *ch)
 {
 	unsigned int sup, mon;
@@ -633,8 +649,7 @@
 		return ret;
 	plugged = mon & RK818_PLUG_IN_STS;
 
-	/* Discharging below the minimum voltage */
-	if ((ua < 0 || (!plugged && ua == 0)) && uv < ch->shutdown_uv) {
+	if (rk818_low_battery(ch, uv, ua, plugged)) {
 		if (!ch->low_volt) {
 			ch->low_volt = true;
 			ch->low_volt_since = jiffies;
@@ -1252,8 +1267,11 @@
 				ret = rk818_save_gauge(ch, 0, ch->design_uah);
 		}
 		mutex_unlock(&ch->lock);
-		__hw_protection_trigger("RK818 battery voltage too low",
-					RK818_SHUTDOWN_MS, HWPROT_ACT_SHUTDOWN);
+		/* No forced step from the kernel: it would end in a restart */
+		__hw_protection_trigger("RK818 battery voltage too low", -1,
+					HWPROT_ACT_SHUTDOWN);
+		queue_delayed_work(system_unbound_wq, &ch->off_work,
+				   msecs_to_jiffies(RK818_FORCE_OFF_MS));
 	} else {
 		if (ret) {
 			ch->neg_cnt = false;
@@ -1277,6 +1295,40 @@
 			   msecs_to_jiffies(RK818_MONITOR_MS));
 }
 
+/*
+ * The forced step of the low battery power-off. The kernel's own one
+ * (hw_failure_emergency_action_func) calls kernel_power_off(), which always
+ * returns on this board: the RK818 is switched off in the power-off prepare
+ * step and nothing handles the final step. It then restarts the system
+ * at once. Here DEV_OFF is set directly instead, unless the battery is no
+ * longer low by the same test that started the power-off.
+ */
+static void rk818_off_work(struct work_struct *work)
+{
+	struct rk818_charger *ch = container_of(to_delayed_work(work),
+						struct rk818_charger, off_work);
+	unsigned int mon;
+	int uv, ua, ret;
+
+	if (!rk818_read_voltage(ch, &uv) && !rk818_read_current(ch, &ua) &&
+	    !regmap_read(ch->regmap, RK808_VB_MON_REG, &mon) &&
+	    !rk818_low_battery(ch, uv, ua, mon & RK818_PLUG_IN_STS)) {
+		dev_emerg(ch->dev, "battery recovered (%d uV, %d uA): forced power-off cancelled\n",
+			  uv, ua);
+		return;
+	}
+
+	dev_emerg(ch->dev, "power-off did not finish: switching the PMIC off\n");
+	emergency_sync();
+	msleep(RK818_FORCE_SYNC_MS);
+	ret = rk818_update(ch->regmap, RK818_DEVCTRL_REG, DEV_OFF, DEV_OFF);
+	msleep(RK818_FORCE_RETRY_MS);
+	dev_emerg(ch->dev, "still running after DEV_OFF (%d): trying once more\n", ret);
+	ret = rk818_update(ch->regmap, RK818_DEVCTRL_REG, DEV_OFF, DEV_OFF);
+	msleep(RK818_FORCE_RETRY_MS);
+	dev_emerg(ch->dev, "PMIC did not switch off (%d)\n", ret);
+}
+
 /* Charge current: 1.0 A to 3.0 A in steps of 0.2 A */
 static int rk818_cc_sel(int ua)
 {
@@ -1667,6 +1719,9 @@
 	ret = devm_delayed_work_autocancel(dev, &ch->led_work, rk818_led_work);
 	if (ret)
 		return ret;
+	ret = devm_delayed_work_autocancel(dev, &ch->off_work, rk818_off_work);
+	if (ret)
+		return ret;
 
 	if (ch->edev) {
 		ch->nb.notifier_call = rk818_cable_changed;
