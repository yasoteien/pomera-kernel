--- a/drivers/mfd/rk8xx-i2c.c	2026-11-02 22:57:34.433384292 +0900
+++ b/drivers/mfd/rk8xx-i2c.c	2026-11-02 23:00:46.057878449 +0900
@@ -89,6 +89,15 @@
