 }
 
+static bool rk818_is_volatile_reg(struct device *dev, unsigned int reg)
+{
+	/* Charger, fuel gauge and data registers are all live */
+	if (reg >= RK818_SUP_STS_REG && reg <= RK818_DATA19_REG)
+		return true;
+
+	return rk808_is_volatile_reg(dev, reg);
+}
+
 static bool rk817_is_volatile_reg(struct device *dev, unsigned int reg)
 {
 	/*
@@ -119,9 +128,9 @@
 static const struct regmap_config rk818_regmap_config = {
 	.reg_bits = 8,
 	.val_bits = 8,
-	.max_register = RK818_USB_CTRL_REG,
+	.max_register = RK818_DATA19_REG,
 	.cache_type = REGCACHE_MAPLE,
-	.volatile_reg = rk808_is_volatile_reg,
+	.volatile_reg = rk818_is_volatile_reg,
 };
 
