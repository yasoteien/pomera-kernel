From ca9bf3ed6857eb8125ca20052fbe3ac25d0f40bd Mon Sep 17 00:00:00 2001
From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Date: Wed, 18 Nov 2026 18:11:28 +0900
Subject: [PATCH 33/33] power: supply: rk818: Set the charge voltage from the
 battery node

The charger was always set to 4.2 V, and a battery node with a lower
charge voltage only gave a warning. Set CHRG_VOL_SEL from it instead
(4.05 V to 4.2 V, rounded down to a 50 mV step), refuse a value below
4.05 V, and keep 4.2 V as the highest. The DM250 battery node gives
4.2 V, so the register value does not change there.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
 drivers/power/supply/rk818_charger.c | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/drivers/power/supply/rk818_charger.c b/drivers/power/supply/rk818_charger.c
index e6a944bc0..4744772bc 100644
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -50,8 +50,12 @@
 #define RK818_CHRG_CTRL_REG1		0xa3
 #define RK818_CHRG_CTRL_REG2		0xa4
 #define RK818_CHRG_CTRL_REG3		0xa5
-/* Charger enabled, 4.2 V */
-#define RK818_CHRG_CTRL1_BASE		0xb0
+/* CHRG_CTRL1: charger enable, charge voltage 4.05 V + 50 mV steps */
+#define RK818_CHRG_EN			BIT(7)
+#define RK818_CHRG_VOL_SEL		GENMASK(6, 4)
+#define RK818_CV_MIN_UV			4050000
+#define RK818_CV_STEP_UV		50000
+/* Highest charge voltage used: the DM250 battery's */
 #define RK818_CV_UV			4200000
 
 /*
@@ -1294,7 +1298,9 @@ static int rk818_charger_init(struct rk818_charger *ch)
 		return ret;
 
 	ret = rk818_update(ch->regmap, RK818_CHRG_CTRL_REG1, 0xff,
-			   RK818_CHRG_CTRL1_BASE | sel);
+			   RK818_CHRG_EN | sel |
+			   FIELD_PREP(RK818_CHRG_VOL_SEL,
+				      (ch->cv_uv - RK818_CV_MIN_UV) / RK818_CV_STEP_UV));
 	if (ret)
 		return ret;
 
@@ -1492,12 +1498,20 @@ static int rk818_read_battery(struct rk818_charger *ch)
 	ch->ir_uohm = max(info->factory_internal_resistance_uohm, 0);
 	ch->cc_ua = info->constant_charge_current_max_ua;
 	ch->cv_uv = info->constant_charge_voltage_max_uv;
-	if (ch->cv_uv != RK818_CV_UV) {
-		/* The charger is always set to 4.2 V: judge "full" by that */
-		dev_warn(ch->dev, "charge voltage %d uV not supported: using %d uV\n",
+	/*
+	 * The charger is set to this voltage. Below 4.05 V cannot be set,
+	 * so refuse; above 4.2 V is not used; between, round down.
+	 */
+	if (ch->cv_uv < RK818_CV_MIN_UV) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (ch->cv_uv > RK818_CV_UV) {
+		dev_warn(ch->dev, "charge voltage %d uV: using %d uV\n",
 			 ch->cv_uv, RK818_CV_UV);
 		ch->cv_uv = RK818_CV_UV;
 	}
+	ch->cv_uv -= (ch->cv_uv - RK818_CV_MIN_UV) % RK818_CV_STEP_UV;
 
 	table = power_supply_find_ocv2cap_table(info, RK818_OCV_TEMP_C, &len);
 	if (table) {
-- 
