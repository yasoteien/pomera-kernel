From ac3dd31c7b11dbba78fd980b63bf57c1c2e4cf29 Mon Sep 17 00:00:00 2001
From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Date: Wed, 18 Nov 2026 17:57:16 +0900
Subject: [PATCH] power: supply: rk818: Pause charging when the battery is hot

The battery NTC on TS1 was read by no one, and the PMIC charge pause on
temperature was left off (BAT_HTS_TS1 0x00), as with the vendor kernel,
whose DM250 device tree had no NTC table. Turn the TS1 ADC on and set
the hot threshold to 0x1c: charging pauses while the NTC reads below
3.1 kOhm, 54 to 59 C for a 10 kOhm NTC of B 3380 to 3950, and goes on
by itself when it cools. The threshold is compared with the top 8 bits
of the TS1 ADC (tried on a DM250: 0x4c paused at a reading of 1190,
0x4a did not). Cold cannot be seen, as the ADC tops out near 0 C.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
 drivers/power/supply/rk818_charger.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/power/supply/rk818_charger.c b/drivers/power/supply/rk818_charger.c
index 729cff467..97aa88a21 100644
--- a/drivers/power/supply/rk818_charger.c
+++ b/drivers/power/supply/rk818_charger.c
@@ -53,12 +53,25 @@
 /* Charger enabled, 4.2 V */
 #define RK818_CHRG_CTRL1_BASE		0xb0
 #define RK818_CV_UV			4200000
+
+/*
+ * Charging pauses while the battery NTC (TS1, 80 uA) reads below this,
+ * compared with the top 8 bits of the 12-bit TS1 ADC (seen on a DM250:
+ * 0x4c paused at a reading of 1190, 0x4a did not). 0x1c is 448 counts,
+ * 3.1 kOhm (7 Ohm a count): 54 to 59 C for a 10 kOhm NTC of B 3380 to
+ * 3950. The NTC reads about 8.3 kOhm while charging at room temperature.
+ * Cold cannot be seen: the ADC tops out near 27.5 kOhm (about 0 C).
+ */
+#define RK818_BAT_HTS_TS1_VAL		0x1c
 /* Termination 100 mA, trickle timer 60 min, CC/CV timer 12 h */
 #define RK818_CHRG_CTRL2_VAL		0x0d
 /* Digital termination, CC/CV timer on */
 #define RK818_CHRG_CTRL3_VAL		0x26
 
+#define RK818_BAT_HTS_TS1_REG		0xa8
 #define RK818_TS_CTRL_REG		0xac
+#define RK818_ADC_CTRL_REG		0xad
+#define RK818_ADC_TS1_EN		BIT(5)
 #define RK818_TS_CTRL_GG_EN		BIT(7)
 #define RK818_GGCON_REG			0xb0
 /* ADC offset calibration and OCV sampling intervals: 8 min */
@@ -158,6 +171,8 @@ static const struct {
 	{ RK818_CHRG_CTRL_REG2, 0xff },
 	{ RK818_CHRG_CTRL_REG3, 0xff },
 	{ RK818_TS_CTRL_REG, RK818_TS_CTRL_GG_EN },
+	{ RK818_ADC_CTRL_REG, RK818_ADC_TS1_EN },
+	{ RK818_BAT_HTS_TS1_REG, 0xff },
 	{ RK818_GGCON_REG, RK818_GGCON_INTERV_MASK },
 	{ RK818_GGSTS_REG, RK818_GGSTS_BAT_CON },
 	{ RK818_DATA_SOC_REG, 0xff },
@@ -1283,6 +1298,19 @@ static int rk818_charger_init(struct rk818_charger *ch)
 	if (ret)
 		return ret;
 
+	/*
+	 * The TS1 ADC first: with a threshold set and no reading the
+	 * charger could pause. Both reset to off with the PMIC.
+	 */
+	ret = rk818_update(ch->regmap, RK818_ADC_CTRL_REG, RK818_ADC_TS1_EN,
+			   RK818_ADC_TS1_EN);
+	if (ret)
+		return ret;
+	ret = rk818_update(ch->regmap, RK818_BAT_HTS_TS1_REG, 0xff,
+			   RK818_BAT_HTS_TS1_VAL);
+	if (ret)
+		return ret;
+
 	return rk818_update(ch->regmap, RK818_SUP_STS_REG, RK818_SUP_STS_ILIM_MASK,
 			    RK818_SUP_STS_ILIM_EN);
 }
