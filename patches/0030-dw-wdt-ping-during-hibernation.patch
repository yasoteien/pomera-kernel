From eaf5f9c85928c3b63918060ffe6cbbe1e5f3cc0b Mon Sep 17 00:00:00 2001
From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Date: Wed, 18 Nov 2026 15:55:15 +0900
Subject: [PATCH 30/30] watchdog: dw_wdt: Keep pinging while a hibernation
 image is written

The core ping worker was stopped from PM_SUSPEND_PREPARE and
PM_HIBERNATION_PREPARE to the end of the sleep, as it must not touch
the registers while the clocks are gated. For hibernation that also
covered the writing of the image, with the clocks on and the watchdog
counting: a watchdog left running by the core (it cannot be stopped on
the RK3128) then reset the system if the image took longer than the
timeout. Keep the worker running and skip only the ping between suspend
and resume, under a spinlock.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
 drivers/watchdog/dw_wdt.c | 41 ++++++++++++++++++++++++++++++++-------
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/drivers/watchdog/dw_wdt.c b/drivers/watchdog/dw_wdt.c
index 24ff90e9f..476d9d15f 100644
--- a/drivers/watchdog/dw_wdt.c
+++ b/drivers/watchdog/dw_wdt.c
@@ -96,6 +96,9 @@ struct dw_wdt {
 	u32			control;
 	u32			timeout;
 	bool			kept;
+	/* Set from suspend to resume; protects the ping from gated clocks */
+	spinlock_t		sleep_lock;
+	bool			asleep;
 
 #ifdef CONFIG_DEBUG_FS
 	struct dentry		*dbgfs_dir;
@@ -190,16 +193,40 @@ static unsigned int dw_wdt_get_timeout(struct dw_wdt *dw_wdt)
 	return dw_wdt->timeouts[idx].sec * dw_wdt->rmod;
 }
 
+static void dw_wdt_kick(struct dw_wdt *dw_wdt)
+{
+	writel(WDOG_COUNTER_RESTART_KICK_VALUE, dw_wdt->regs +
+	       WDOG_COUNTER_RESTART_REG_OFFSET);
+}
+
+/*
+ * The core's ping worker keeps running in sleep, and also while a
+ * hibernation image is written, when the clocks are on again. Between
+ * suspend and resume the clocks are gated (or, with keep_in_sleep, the
+ * watchdog is left unpinged on purpose), so the ping is skipped then.
+ */
 static int dw_wdt_ping(struct watchdog_device *wdd)
 {
 	struct dw_wdt *dw_wdt = to_dw_wdt(wdd);
+	unsigned long flags;
 
-	writel(WDOG_COUNTER_RESTART_KICK_VALUE, dw_wdt->regs +
-	       WDOG_COUNTER_RESTART_REG_OFFSET);
+	spin_lock_irqsave(&dw_wdt->sleep_lock, flags);
+	if (!dw_wdt->asleep)
+		dw_wdt_kick(dw_wdt);
+	spin_unlock_irqrestore(&dw_wdt->sleep_lock, flags);
 
 	return 0;
 }
 
+static void dw_wdt_set_asleep(struct dw_wdt *dw_wdt, bool asleep)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dw_wdt->sleep_lock, flags);
+	dw_wdt->asleep = asleep;
+	spin_unlock_irqrestore(&dw_wdt->sleep_lock, flags);
+}
+
 static int dw_wdt_set_timeout(struct watchdog_device *wdd, unsigned int top_s)
 {
 	struct dw_wdt *dw_wdt = to_dw_wdt(wdd);
@@ -389,12 +416,14 @@ static int dw_wdt_suspend(struct device *dev)
 
 	if (keep_in_sleep && dw_wdt_is_enabled(dw_wdt)) {
 		dw_wdt_ping(&dw_wdt->wdd);
+		dw_wdt_set_asleep(dw_wdt, true);
 		dw_wdt->kept = true;
 		dev_info(dev, "kept running in sleep, resets in %u s unless resumed\n",
 			 dw_wdt_get_timeout(dw_wdt));
 		return 0;
 	}
 
+	dw_wdt_set_asleep(dw_wdt, true);
 	clk_disable_unprepare(dw_wdt->pclk);
 	clk_disable_unprepare(dw_wdt->clk);
 
@@ -408,6 +437,7 @@ static int dw_wdt_resume(struct device *dev)
 
 	if (dw_wdt->kept) {
 		dw_wdt->kept = false;
+		dw_wdt_set_asleep(dw_wdt, false);
 		dw_wdt_ping(&dw_wdt->wdd);
 		return 0;
 	}
@@ -425,6 +455,7 @@ static int dw_wdt_resume(struct device *dev)
 	writel(dw_wdt->timeout, dw_wdt->regs + WDOG_TIMEOUT_RANGE_REG_OFFSET);
 	writel(dw_wdt->control, dw_wdt->regs + WDOG_CONTROL_REG_OFFSET);
 
+	dw_wdt_set_asleep(dw_wdt, false);
 	dw_wdt_ping(&dw_wdt->wdd);
 
 	return 0;
@@ -575,6 +606,7 @@ static int dw_wdt_drv_probe(struct platform_device *pdev)
 	dw_wdt = devm_kzalloc(dev, sizeof(*dw_wdt), GFP_KERNEL);
 	if (!dw_wdt)
 		return -ENOMEM;
+	spin_lock_init(&dw_wdt->sleep_lock);
 
 	dw_wdt->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(dw_wdt->regs))
@@ -672,11 +704,6 @@ static int dw_wdt_drv_probe(struct platform_device *pdev)
 
 	watchdog_set_restart_priority(wdd, 128);
 	watchdog_stop_on_reboot(wdd);
-	/*
-	 * The clocks are gated in suspend, so keep the core's ping worker,
-	 * which still runs in s2idle, away from the registers until resume.
-	 */
-	watchdog_stop_ping_on_suspend(wdd);
 
 	ret = watchdog_register_device(wdd);
 	if (ret)
-- 
