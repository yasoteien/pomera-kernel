 enum dwc2_transaction_type dwc2_hcd_select_transactions(
--- a/drivers/usb/dwc2/hcd.c
+++ b/drivers/usb/dwc2/hcd.c
@@ -19,6 +19,8 @@
 #include <linux/io.h>
 #include <linux/slab.h>
 #include <linux/usb.h>
+#include <linux/phy/phy.h>
+#include <linux/pm_runtime.h>
 
 #include <linux/usb/hcd.h>
 #include <linux/usb/ch11.h>
@@ -1561,6 +1563,105 @@
  * =========================================================================
  */
 
+#define DWC2_CHARGER_POLL_MS	2000
+
+/*
+ * While nothing is attached to the root port, let the PHY look for a
+ * charger on the data lines.  The probing disturbs the lines, so keep the
+ * controller quiet meanwhile and drop the port events it causes.
+ */
+static void dwc2_charger_work(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = container_of(work, struct dwc2_hsotg,
+						charger_work.work);
+	struct usb_hcd *hcd = dwc2_hsotg_to_hcd(hsotg);
+	struct usb_device *rhdev = hcd->self.root_hub;
+	bool connected = false;
+	unsigned long flags;
+	u32 hprt0, gintmsk;
+	int ret;
+
+	if (pm_runtime_resume_and_get(&rhdev->dev) < 0)
+		goto requeue;
+
+	usb_lock_device(rhdev);
+	spin_lock_irqsave(&hsotg->lock, flags);
+
+	if (!HCD_HW_ACCESSIBLE(hcd) || hsotg->lx_state != DWC2_L0 ||
+	    !dwc2_is_host_mode(hsotg))
+		goto unlock;
+
+	hprt0 = dwc2_readl(hsotg, HPRT0);
+	if ((hprt0 & HPRT0_CONNSTS) || hsotg->flags.b.port_connect_status ||
+	    usb_hub_find_child(rhdev, 1)) {
+		spin_unlock_irqrestore(&hsotg->lock, flags);
+		phy_notify_connect(hsotg->phy, 1);
+		goto unlock_dev;
+	}
+
+	if (hprt0 & (HPRT0_ENA | HPRT0_RES | HPRT0_RST))
+		goto unlock;
+	if (!(dwc2_readl(hsotg, GAHBCFG) & GAHBCFG_GLBL_INTR_EN))
+		goto unlock;
+
+	gintmsk = dwc2_readl(hsotg, GINTMSK);
+	dwc2_disable_global_interrupts(hsotg);
+	dwc2_writel(hsotg, 0, GINTMSK);
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+	synchronize_irq(hsotg->irq);
+
+	ret = phy_notify_disconnect(hsotg->phy, 1);
+	usleep_range(1500, 2000);
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	hprt0 = dwc2_readl(hsotg, HPRT0);
+	if (hprt0 & HPRT0_CONNSTS) {
+		connected = true;
+	} else {
+		hprt0 &= ~(HPRT0_CONNDET | HPRT0_ENA | HPRT0_ENACHG |
+			   HPRT0_OVRCURRCHG);
+		hprt0 |= HPRT0_CONNDET | HPRT0_ENACHG;
