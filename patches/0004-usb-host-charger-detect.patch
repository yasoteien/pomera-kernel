From: yasoteien <263659156+yasoteien@users.noreply.github.com>
Subject: [PATCH] phy: rockchip: inno-usb2: Detect chargers while the OTG port is a host

On the Pomera DM250 the dwc2 controller is fixed to host mode and
nothing drives VBUS, so the BC1.2 detection in
rockchip_chg_detect_work() never runs. Run the detection from the
bvalid interrupt, from the dwc2 idle poll (phy_notify_disconnect())
and from a slow poll while the port is powered off, and report the
result through the PHY's own extcon device.

Signed-off-by: yasoteien <263659156+yasoteien@users.noreply.github.com>
---
--- a/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
+++ b/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
@@ -8,6 +8,7 @@
 #include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/delay.h>
+#include <linux/devm-helpers.h>
 #include <linux/extcon-provider.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -203,6 +204,10 @@
  * @event_nb: hold event notification callback.
  * @state: define OTG enumeration states before device reset.
  * @mode: the dr_mode of the controller.
+ * @host_chg: charger detection while the otg port stays in host mode.
+ * @host_chg_work: charger detection work for host mode.
+ * @host_chg_cable: last extcon cable found in host mode, 0 if none.
+ * @host_chg_seq: bumped on each VBUS event, drops a stale result.
  */
 struct rockchip_usb2phy_port {
 	struct phy	*phy;
@@ -222,6 +227,10 @@
 	struct notifier_block	event_nb;
 	enum usb_otg_state	state;
 	enum usb_dr_mode	mode;
+	bool		host_chg;
+	struct		delayed_work host_chg_work;
+	unsigned int	host_chg_cable;
+	atomic_t	host_chg_seq;
 };
 
 /**
@@ -570,6 +579,377 @@
 	return ret;
 }
 
+/*
+ * Charger detection while the OTG port stays in host mode (Pomera DM250).
+ *
+ * The dwc2 controller is fixed to host mode and nothing drives VBUS, so the
+ * BC1.2 detection in rockchip_chg_detect_work() never runs.  Instead the
+ * bvalid interrupt, the dwc2 idle poll (phy_notify_disconnect()) and a slow
+ * poll while the port is powered off run the detection below, and the
+ * result is reported through the PHY's own extcon device.
+ */
+#define HOST_CHG_POLL_MS	2000
+#define HOST_CHG_DCD_TRIES	6
+/* idp_sink_en .. vdm_src_en (rk3128: bits 12:7 of 0x184) all off */
+#define HOST_CHG_DET_OFF	(GENMASK(12, 7) << BIT_WRITEABLE_SHIFT)
+/* phy_sus value used while probing the data lines */
+#define HOST_CHG_PHY_SUS	0x17
+
+static const unsigned int rockchip_usb2phy_host_cables[] = {
+	EXTCON_CHG_USB_SDP,
+	EXTCON_CHG_USB_CDP,
+	EXTCON_CHG_USB_DCP,
+};
+
+static void rockchip_usb2phy_charger_notify(struct rockchip_usb2phy *rphy,
+					    struct rockchip_usb2phy_port *rport,
+					    unsigned int cable)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rockchip_usb2phy_host_cables); i++) {
+		unsigned int c = rockchip_usb2phy_host_cables[i];
+
+		if (c != cable && extcon_get_state(rphy->edev, c) > 0)
+			extcon_set_state_sync(rphy->edev, c, false);
+	}
+
+	if (cable && !extcon_get_state(rphy->edev, cable))
+		extcon_set_state_sync(rphy->edev, cable, true);
+
+	rport->host_chg_cable = cable;
+}
+
+static int rockchip_usb2phy_charger_read(struct regmap *base,
+					 const struct usb2phy_reg *reg,
+					 bool *en)
+{
+	unsigned int orig, tmp;
+	int ret;
+
+	ret = regmap_read(base, reg->offset, &orig);
+	if (ret)
+		return ret;
+
+	tmp = (orig & GENMASK(reg->bitend, reg->bitstart)) >> reg->bitstart;
+	*en = tmp == reg->enable;
+	return 0;
+}
+
+static int rockchip_usb2phy_host_charger_check(struct rockchip_usb2phy *rphy,
+					       struct rockchip_usb2phy_port *rport,
+					       bool force)
+{
+	const struct rockchip_chg_det_reg *det = &rphy->phy_cfg->chg_det;
+	const struct usb2phy_reg *sus = &rport->port_cfg->phy_sus;
+	struct regmap *base = get_reg_base(rphy);
+	int seq = atomic_read(&rport->host_chg_seq);
+	unsigned int cable = 0, found = 0, sus_val = 0, mask;
+	bool vbus, id, cp, dcp, dp;
+	int ret, ret2, tries;
+
+	ret = rockchip_usb2phy_charger_read(rphy->grf,
+					    &rport->port_cfg->utmi_bvalid, &vbus);
+	if (ret || !vbus)
+		goto out;
+
+	ret = rockchip_usb2phy_charger_read(rphy->grf,
+					    &rport->port_cfg->utmi_id, &id);
+	if (ret || !id)
+		goto out;
+
+	/* keep the last result while VBUS stays */
+	cable = rport->host_chg_cable;
+	if (cable)
+		goto out;
+
+	/* the data lines are free while the port is powered off */
+	if (!rport->phy->power_count)
+		force = true;
+	if (!force)
+		goto out;
+
+	ret = regmap_read(base, sus->offset, &sus_val);
+	if (ret)
+		goto out;
+
+	ret = clk_prepare_enable(rphy->clk480m);
+	if (ret)
+		goto out;
+
+	mask = GENMASK(sus->bitend, sus->bitstart);
+
+	ret = regmap_write(base, det->idp_src_en.offset, HOST_CHG_DET_OFF);
+	if (ret)
+		goto restore;
+
+	ret = regmap_write(base, sus->offset,
+			   (mask << BIT_WRITEABLE_SHIFT) |
+			   (HOST_CHG_PHY_SUS << sus->bitstart));
+	if (ret)
+		goto restore;
+
+	usleep_range(1500, 2000);
+
+	/* data contact detection */
+	ret = property_enable(base, &det->rdm_pdwn_en, true);
+	if (ret)
+		goto restore;
+	ret = property_enable(base, &det->idp_src_en, true);
+	if (ret)
+		goto restore;
+
+	for (tries = HOST_CHG_DCD_TRIES; tries; tries--) {
+		msleep(100);
+		ret = rockchip_usb2phy_charger_read(rphy->grf, &det->dp_det, &dp);
+		if (ret)
+			goto restore;
+		if (dp)
+			break;
+	}
+	if (!tries)
+		goto done;
+
+	/* primary detection */
+	ret = property_enable(base, &det->rdm_pdwn_en, false);
+	if (ret)
+		goto restore;
+	ret = property_enable(base, &det->idp_src_en, false);
+	if (ret)
+		goto restore;
+	ret = property_enable(base, &det->vdp_src_en, true);
+	if (ret)
+		goto restore;
+	ret = property_enable(base, &det->idm_sink_en, true);
+	if (ret)
+		goto restore;
+	msleep(40);
+	ret = rockchip_usb2phy_charger_read(rphy->grf, &det->cp_det, &cp);
+	if (ret)
+		goto restore;
+
+	if (!cp) {
+		found = EXTCON_CHG_USB_SDP;
+	} else {
+		/* secondary detection */
+		ret = property_enable(base, &det->vdp_src_en, false);
+		if (ret)
+			goto restore;
+		ret = property_enable(base, &det->idm_sink_en, false);
+		if (ret)
+			goto restore;
+		msleep(40);
+		ret = property_enable(base, &det->vdm_src_en, true);
+		if (ret)
+			goto restore;
+		ret = property_enable(base, &det->idp_sink_en, true);
+		if (ret)
+			goto restore;
+		msleep(40);
+		ret = rockchip_usb2phy_charger_read(rphy->grf, &det->dcp_det,
+						    &dcp);
+		if (ret)
+			goto restore;
+		found = dcp ? EXTCON_CHG_USB_DCP : EXTCON_CHG_USB_CDP;
+	}
+
+	/* drop the result if VBUS or ID changed meanwhile */
+	ret = rockchip_usb2phy_charger_read(rphy->grf,
+					    &rport->port_cfg->utmi_bvalid, &vbus);
+	if (ret)
+		goto restore;
+	ret = rockchip_usb2phy_charger_read(rphy->grf,
+					    &rport->port_cfg->utmi_id, &id);
+	if (ret)
+		goto restore;
+	if (!vbus || !id)
+		found = 0;
+
+done:
+	ret = regmap_write(base, det->idp_src_en.offset, HOST_CHG_DET_OFF);
+	ret2 = regmap_write(base, sus->offset,
+			    (mask << BIT_WRITEABLE_SHIFT) | (sus_val & mask));
+	clk_disable_unprepare(rphy->clk480m);
+	if (!ret)
+		ret = ret2;
+	if (!ret)
+		cable = found;
+	goto out;
+
+restore:
+	regmap_write(base, det->idp_src_en.offset, HOST_CHG_DET_OFF);
+	regmap_write(base, sus->offset,
+		     (mask << BIT_WRITEABLE_SHIFT) | (sus_val & mask));
+	clk_disable_unprepare(rphy->clk480m);
+
+out:
+	if (seq != atomic_read(&rport->host_chg_seq))
+		cable = 0;
+	rockchip_usb2phy_charger_notify(rphy, rport, cable);
+	return ret;
+}
+
+/* called by dwc2 with phy->mutex held */
+static int rockchip_usb2phy_connect(struct phy *phy, int port)
+{
+	struct rockchip_usb2phy_port *rport = phy_get_drvdata(phy);
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(phy->dev.parent);
+
+	if (rport->host_chg)
+		rockchip_usb2phy_charger_notify(rphy, rport, 0);
+
+	return 0;
+}
+
+static int rockchip_usb2phy_disconnect(struct phy *phy, int port)
+{
+	struct rockchip_usb2phy_port *rport = phy_get_drvdata(phy);
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(phy->dev.parent);
+
+	if (!rport->host_chg)
+		return 0;
+
+	return rockchip_usb2phy_host_charger_check(rphy, rport, true);
+}
+
+static void rockchip_usb2phy_host_charger_work(struct work_struct *work)
+{
+	struct rockchip_usb2phy_port *rport =
+		container_of(work, struct rockchip_usb2phy_port,
+			     host_chg_work.work);
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(rport->phy->dev.parent);
+	int ret;
+
+	mutex_lock(&rport->phy->mutex);
+	ret = rockchip_usb2phy_host_charger_check(rphy, rport, false);
+	mutex_unlock(&rport->phy->mutex);
+	if (ret)
+		dev_err_ratelimited(rphy->dev,
+				    "charger-only detection failed: %d\n", ret);
+
+	queue_delayed_work(system_freezable_wq, &rport->host_chg_work,
+			   msecs_to_jiffies(HOST_CHG_POLL_MS));
+}
+
+static irqreturn_t rockchip_usb2phy_host_charger_irq(int irq, void *data)
+{
+	struct rockchip_usb2phy_port *rport = data;
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(rport->phy->dev.parent);
+	bool st;
+	int ret;
+
+	if (rockchip_usb2phy_charger_read(rphy->grf,
+					  &rport->port_cfg->bvalid_det_st, &st) ||
+	    !st)
+		return IRQ_NONE;
+
+	atomic_inc(&rport->host_chg_seq);
+	ret = property_enable(rphy->grf, &rport->port_cfg->bvalid_det_clr, true);
+	if (ret)
+		dev_err_ratelimited(rphy->dev,
+				    "charger VBUS IRQ clear failed: %d\n", ret);
+
+	mutex_lock(&rport->phy->mutex);
+	rockchip_usb2phy_charger_notify(rphy, rport, 0);
+	mutex_unlock(&rport->phy->mutex);
+
+	mod_delayed_work(system_freezable_wq, &rport->host_chg_work, 0);
+
+	return IRQ_HANDLED;
+}
+
+static void rockchip_usb2phy_host_charger_disable_irq(void *data)
+{
+	struct rockchip_usb2phy_port *rport = data;
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(rport->phy->dev.parent);
+
+	property_enable(rphy->grf, &rport->port_cfg->bvalid_det_en, false);
+}
+
+static int rockchip_usb2phy_host_charger_init(struct rockchip_usb2phy *rphy,
+					      struct rockchip_usb2phy_port *rport,
+					      struct device_node *child_np)
+{
+	int ret;
+
+	if (!of_device_is_compatible(rphy->dev->of_node,
+				     "rockchip,rk3128-usb2phy") ||
+	    rport->mode != USB_DR_MODE_HOST ||
+	    of_property_present(rphy->dev->of_node, "extcon"))
+		return -EINVAL;
+
+	atomic_set(&rport->host_chg_seq, 0);
+	ret = devm_delayed_work_autocancel(rphy->dev, &rport->host_chg_work,
+					   rockchip_usb2phy_host_charger_work);
+	if (ret)
+		return ret;
+
+	rport->bvalid_irq = of_irq_get_byname(child_np, "otg-bvalid");
+	if (rport->bvalid_irq <= 0)
+		return rport->bvalid_irq ?: -EINVAL;
+
+	ret = devm_request_threaded_irq(rphy->dev, rport->bvalid_irq, NULL,
+					rockchip_usb2phy_host_charger_irq,
+					IRQF_ONESHOT, "rockchip-usb-charger",
+					rport);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action(rphy->dev,
+			      rockchip_usb2phy_host_charger_disable_irq, rport);
+	if (ret) {
+		property_enable(rphy->grf, &rport->port_cfg->bvalid_det_en,
+				false);
+		return ret;
+	}
+
+	ret = property_enable(rphy->grf, &rport->port_cfg->bvalid_det_clr, true);
+	if (ret)
+		return ret;
+
+	return property_enable(rphy->grf, &rport->port_cfg->bvalid_det_en, true);
+}
+
+static int rockchip_usb2phy_charger_suspend(struct device *dev)
+{
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(dev);
+	unsigned int i;
+
+	for (i = 0; i < rphy->phy_cfg->num_ports; i++) {
+		struct rockchip_usb2phy_port *rport = &rphy->ports[i];
+
+		if (!rport->host_chg)
+			continue;
+
+		cancel_delayed_work_sync(&rport->host_chg_work);
+		mutex_lock(&rport->phy->mutex);
+		rockchip_usb2phy_charger_notify(rphy, rport, 0);
+		mutex_unlock(&rport->phy->mutex);
+	}
+
+	return 0;
+}
+
+static int rockchip_usb2phy_charger_resume(struct device *dev)
+{
+	struct rockchip_usb2phy *rphy = dev_get_drvdata(dev);
+	unsigned int i;
+
+	for (i = 0; i < rphy->phy_cfg->num_ports; i++) {
+		struct rockchip_usb2phy_port *rport = &rphy->ports[i];
+
+		if (rport->host_chg)
+			mod_delayed_work(system_freezable_wq,
+					 &rport->host_chg_work, 0);
+	}
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(rockchip_usb2phy_pm_ops,
+				rockchip_usb2phy_charger_suspend,
+				rockchip_usb2phy_charger_resume);
+
 static int rockchip_usb2phy_power_on(struct phy *phy)
 {
 	struct rockchip_usb2phy_port *rport = phy_get_drvdata(phy);
@@ -579,6 +959,9 @@
 
 	dev_dbg(&rport->phy->dev, "port power on\n");
 
+	if (rport->host_chg)
+		rockchip_usb2phy_charger_notify(rphy, rport, 0);
+
 	if (!rport->suspended)
 		return 0;
 
@@ -630,6 +1013,9 @@
 	rport->suspended = true;
 	clk_disable_unprepare(rphy->clk480m);
 
+	if (rport->host_chg)
+		mod_delayed_work(system_freezable_wq, &rport->host_chg_work, 0);
+
 	return 0;
 }
 
@@ -653,6 +1039,8 @@
 	.exit		= rockchip_usb2phy_exit,
 	.power_on	= rockchip_usb2phy_power_on,
 	.power_off	= rockchip_usb2phy_power_off,
+	.connect	= rockchip_usb2phy_connect,
+	.disconnect	= rockchip_usb2phy_disconnect,
 	.owner		= THIS_MODULE,
 };
 
@@ -1302,6 +1690,11 @@
 	mutex_init(&rport->mutex);
 
 	rport->mode = of_usb_get_dr_mode_by_phy(child_np, -1);
+	rport->host_chg = of_property_read_bool(child_np,
+						"rockchip,host-charger-detection");
+	if (rport->host_chg)
+		return rockchip_usb2phy_host_charger_init(rphy, rport, child_np);
+
 	if (rport->mode == USB_DR_MODE_HOST ||
 	    rport->mode == USB_DR_MODE_UNKNOWN) {
 		ret = 0;
@@ -1486,6 +1879,16 @@
 	}
 
 	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	if (IS_ERR(provider))
+		return PTR_ERR(provider);
+
+	for (index = 0; index < rphy->phy_cfg->num_ports; index++) {
+		struct rockchip_usb2phy_port *rport = &rphy->ports[index];
+
+		if (rport->host_chg)
+			queue_delayed_work(system_freezable_wq,
+					   &rport->host_chg_work, 0);
+	}
 
 	if (rphy->irq > 0) {
 		ret = devm_request_threaded_irq(rphy->dev, rphy->irq, NULL,
@@ -2307,6 +2710,7 @@
 	.probe		= rockchip_usb2phy_probe,
 	.driver		= {
 		.name	= "rockchip-usb2phy",
+		.pm	= pm_sleep_ptr(&rockchip_usb2phy_pm_ops),
 		.of_match_table = rockchip_usb2phy_dt_match,
 	},
 };
--- a/drivers/usb/dwc2/core.h
+++ b/drivers/usb/dwc2/core.h
@@ -1133,6 +1133,10 @@
 #define DWC2_RESTORE_DCFG BIT(1)
 
 #if IS_ENABLED(CONFIG_USB_DWC2_HOST) || IS_ENABLED(CONFIG_USB_DWC2_DUAL_ROLE)
+	/* idle charger detection through the PHY (Pomera DM250) */
+	struct delayed_work charger_work;
+	bool charger_detect_enabled;
+
 	union dwc2_hcd_internal_flags {
 		u32 d32;
 		struct {
@@ -1532,6 +1536,7 @@
 static inline void dwc2_hcd_disconnect(struct dwc2_hsotg *hsotg, bool force) {}
