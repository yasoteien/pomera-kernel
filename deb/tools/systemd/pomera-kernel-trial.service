[Unit]
Description=Try a staged Pomera kernel once (kexec with a watchdog)
Documentation=file:/usr/share/doc/pomera-kernel-tools/README.md
After=multi-user.target
ConditionKernelCommandLine=!pomera.trial
ConditionPathExistsGlob=/var/lib/pomera-kernel/*

[Service]
Type=oneshot
ExecStart=/usr/sbin/pomera-kernel boot-trial

[Install]
WantedBy=multi-user.target
